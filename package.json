{
  "name": "typescript-python-web",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --check .",
    "typecheck": "astro check",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:components": "vitest run tests/unit/components/",
    "test:a11y": "vitest run tests/a11y/",
    "test:e2e": "playwright test",
    "linkcheck": "node scripts/link-check.mjs",
    "check": "npm run lint && npm run lint:content && npm run format && npm run typecheck && npm run build && npm run test:coverage && npm run linkcheck",
    "lighthouse": "npx --yes @lhci/cli autorun --config=lighthouserc.json",
    "lint:content": "node scripts/content-lint.mjs"
  },
  "dependencies": {
    "@astrojs/starlight": "^0.42.0",
    "astro": "^7.3.1",
    "sharp": "^0.33.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.7",
    "@eslint/js": "^9.0.0",
    "@playwright/test": "^1.40.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/user-event": "^14.6.1",
    "@types/jsdom": "^28.0.0",
    "@vitest/coverage-v8": "^5.0.0",
    "axe-core": "^4.11.1",
    "eslint": "^9.0.0",
    "eslint-plugin-astro": "^3.1.0",
    "jsdom": "^28.1.0",
    "prettier": "^3.0.0",
    "prettier-plugin-astro": "^0.14.1",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^5.0.0",
    "vitest-axe": "^0.1.0"
  }
}
