---
/**
 * 独立 404 页：GitHub Pages 直接展示该文件，无法依赖站点 JS/主题，
 * 因此样式内联、明暗靠 prefers-color-scheme。
 *
 * 配色不在这里硬编码：构建时从 tokens.css 抽取，避免 404 与站点主题漂移
 * （tests/unit/not-found.test.ts 会校验这条链路仍然成立）。
 */
import tokensCss from "../styles/tokens.css?raw";

const base = import.meta.env.BASE_URL.endsWith("/")
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;

/** 取出某个选择器块内的全部自定义属性声明（正则匹配选择器，避免依赖换行风格） */
function declarations(pattern: RegExp, where: string): Record<string, string> {
  const head = tokensCss.match(pattern);
  if (!head?.index) throw new Error(`tokens.css 中找不到色值块：${where}`);
  // head[0] 可能已包含「{」，所以从匹配起点开始找开括号，才是本块自己的
  const open = tokensCss.indexOf("{", head.index);
  const close = tokensCss.indexOf("}", open);
  const body = tokensCss.slice(open + 1, close);
  return Object.fromEntries(
    [...body.matchAll(/(--[\w-]+)\s*:\s*([^;]+);/g)].map((m) => [m[1].trim(), m[2].trim()])
  );
}

// 顺序敏感：原语块是文件中第一个 `:root {`，明暗两块按 data-theme 标识取
const primitives = declarations(/^:root\s*\{/m, "primitives");
const light = declarations(/:root,\s*\[data-theme="light"\]\s*\{/, "light");
const dark = declarations(/\[data-theme="dark"\]\s*\{/, "dark");

/** 把 var(--x) 解析成原语字面值；已经是字面值的原样返回 */
function resolve(value: string | undefined, where: string): string {
  if (!value) throw new Error(`tokens.css 的 ${where} 块缺少需要的变量`);
  const ref = value.match(/^var\(\s*(--[\w-]+)\s*\)$/);
  if (!ref) return value;
  return primitives[ref[1]] ?? value;
}

const c = {
  // 亮色
  lPage: resolve(light["--surface-page"], "light"),
  lCard: resolve(light["--surface-raised"], "light"),
  lInk: resolve(light["--text-strong"], "light"),
  lMuted: resolve(light["--text-muted"], "light"),
  lBorder: resolve(light["--border-subtle"], "light"),
  lAccent: resolve(light["--accent"], "light"),
  lAccentHover: resolve(light["--accent-hover"], "light"),
  lAccentQuiet: resolve(light["--accent-quiet"], "light"),
  lAccentInk: resolve(light["--accent-ink"], "light"),
  // 暗色
  dPage: resolve(dark["--surface-page"], "dark"),
  dCard: resolve(dark["--surface-raised"], "dark"),
  dInk: resolve(dark["--text-strong"], "dark"),
  dMuted: resolve(dark["--text-muted"], "dark"),
  dBorder: resolve(dark["--border-subtle"], "dark"),
  dAccent: resolve(dark["--accent"], "dark"),
  dAccentHover: resolve(dark["--accent-hover"], "dark"),
  dAccentQuiet: resolve(dark["--accent-quiet"], "dark"),
  dAccentInk: resolve(dark["--accent-ink"], "dark"),
};

const exits = [
  { label: "课程", href: `${base}paths/` },
  { label: "题库", href: `${base}algorithms/` },
  { label: "手册", href: `${base}handbook/` },
];
---

<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>页面不存在 | Python to TypeScript</title>
    <meta name="robots" content="noindex" />
    <style define:vars={c}>
      :root {
        color-scheme: light dark;
        --bg: var(--lPage);
        --card: var(--lCard);
        --ink: var(--lInk);
        --muted: var(--lMuted);
        --border: var(--lBorder);
        --accent: var(--lAccent);
        --accent-hover: var(--lAccentHover);
        --accent-quiet: var(--lAccentQuiet);
        --accent-ink: var(--lAccentInk);
        --cjk:
          "PingFang SC", "HarmonyOS Sans SC", "Hiragino Sans GB", "Microsoft YaHei",
          "Source Han Sans SC", "Noto Sans CJK SC", sans-serif;
      }
      @media (prefers-color-scheme: dark) {
        :root {
          --bg: var(--dPage);
          --card: var(--dCard);
          --ink: var(--dInk);
          --muted: var(--dMuted);
          --border: var(--dBorder);
          --accent: var(--dAccent);
          --accent-hover: var(--dAccentHover);
          --accent-quiet: var(--dAccentQuiet);
          --accent-ink: var(--dAccentInk);
        }
      }
      * {
        box-sizing: border-box;
      }
      body {
        display: grid;
        place-items: center;
        min-height: 100vh;
        margin: 0;
        padding: 1.5rem;
        background: var(--bg);
        color: var(--ink);
        font-family:
          "IBM Plex Sans",
          -apple-system,
          BlinkMacSystemFont,
          "Segoe UI",
          var(--cjk);
        -webkit-font-smoothing: antialiased;
      }
      .card {
        max-width: 28rem;
        text-align: center;
        padding: var(--space-12, 3rem) var(--space-8, 2rem);
        border: 1px solid var(--border);
        border-radius: 14px;
        background: var(--card);
      }
      .code {
        display: block;
        font-family: "JetBrains Mono", ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
        font-size: 0.8125rem;
        font-weight: 600;
        letter-spacing: 0.12em;
        color: var(--accent);
      }
      h1 {
        margin: 0.75rem 0 0.5rem;
        font-size: 1.5rem;
        font-weight: 600;
        letter-spacing: -0.015em;
      }
      p {
        margin: 0 0 1.75rem;
        color: var(--muted);
        font-size: 0.9375rem;
        line-height: 1.75;
      }
      .cta {
        display: inline-block;
        padding: 0.625rem 1.25rem;
        border-radius: 8px;
        background: var(--accent);
        color: var(--card);
        font-size: 0.875rem;
        font-weight: 600;
        text-decoration: none;
        transition: background-color 150ms cubic-bezier(0.25, 1, 0.5, 1);
      }
      .cta:hover {
        background: var(--accent-hover);
      }
      /* 404 是流失点，给具体出口而不是只让用户回首页 */
      .exits {
        margin: 1.5rem 0 0;
        padding-top: 1.25rem;
        border-top: 1px solid var(--border);
        font-size: 0.8125rem;
        color: var(--muted);
      }
      .exits ul {
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        gap: 0.375rem 1rem;
        margin: 0.5rem 0 0;
        padding: 0;
        list-style: none;
      }
      .exits a {
        color: var(--accent-ink);
        background: var(--accent-quiet);
        padding: 0.125rem 0.5rem;
        border-radius: 4px;
        text-decoration: none;
      }
      .exits a:hover {
        text-decoration: underline;
        text-underline-offset: 2px;
      }
    </style>
  </head>
  <body>
    <main class="card">
      <span class="code">404</span>
      <h1>页面不存在</h1>
      <p>你访问的地址可能已被移动或删除。</p>
      <a class="cta" href={base}>返回首页</a>
      <div class="exits">
        或直接去：
        <ul>
          {
            exits.map((item) => (
              <li>
                <a href={item.href}>{item.label}</a>
              </li>
            ))
          }
        </ul>
      </div>
    </main>
  </body>
</html>
