---
/**
 * 正文链接的完成标记
 *
 * 重构前内联了一份与 path-map 顺序不一致的课程清单（foundation 顺序错乱）。
 * 现在从 lib/curriculum.ts 派生，与分页、侧边栏进度共用同一份顺序。
 */
import { TRACK_ORDER, trackRoutes } from "../lib/curriculum";

const lessonPaths = TRACK_ORDER.flatMap((track) => trackRoutes(track));
---

<script
  is:inline
  type="application/json"
  data-lesson-paths
  set:html={JSON.stringify(lessonPaths)}
/>

<script>
  import { getProgress, normPath } from "../lib/progress-store";

  function lessonPaths(): string[] {
    const el = document.querySelector<HTMLScriptElement>("script[data-lesson-paths]");
    try {
      return JSON.parse(el?.textContent || "[]");
    } catch {
      return [];
    }
  }

  function addCompletionMarkers(): void {
    const paths = lessonPaths();
    // 一次读入完成清单；改造前这里对每个链接各 JSON.parse 一遍 localStorage
    const completed = new Set(getProgress().lessons.map((l) => normPath(l.path)));

    const known = new Map(paths.map((p) => [normPath(p), p]));

    document.querySelectorAll(".sl-markdown-content a[href]").forEach((link) => {
      const rawHref = link.getAttribute("href") || "";
      let resolved: string;
      try {
        resolved = normPath(new URL(rawHref, window.location.href).pathname);
      } catch {
        return;
      }

      let matched = known.get(resolved);
      if (!matched) {
        for (const p of paths) {
          if (resolved.endsWith(normPath(p))) {
            matched = p;
            break;
          }
        }
      }
      if (!matched) return;
      if (link.querySelector(".lesson-completion-marker")) return;

      const done = completed.has(normPath(matched));
      const marker = document.createElement("span");
      marker.className = "lesson-completion-marker";
      marker.style.cssText =
        "display:inline-block;width:.5rem;height:.5rem;margin-inline-start:.35rem;border:1px solid var(--border-default);border-radius:2px;vertical-align:middle;";
      if (done) {
        marker.style.background = "var(--success)";
        marker.style.borderColor = "var(--success)";
      }
      marker.setAttribute("aria-label", done ? "已完成" : "未完成");
      marker.setAttribute("title", done ? "已完成" : "未完成");
      link.appendChild(marker);
    });
  }

  function schedule(): void {
    setTimeout(addCompletionMarkers, 60);
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", schedule);
  } else {
    schedule();
  }

  window.addEventListener("progress-updated", schedule);
  // Starlight 0.28 是 MPA 全页加载，astro:page-load 当前不会触发；保留监听以便未来升级视图过渡
  document.addEventListener("astro:page-load", schedule);
</script>
