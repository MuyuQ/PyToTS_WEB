---
/**
 * 正文链接的完成标记
 *
 * 重构前内联了一份与 path-map 顺序不一致的课程清单（foundation 顺序错乱）。
 * 现在从 lib/curriculum.ts 派生，与分页、侧边栏进度共用同一份顺序。
 */
import { TRACK_ORDER, trackRoutes } from "../lib/curriculum";

const lessonPaths = TRACK_ORDER.flatMap((track) => trackRoutes(track));
---

<script is:inline define:vars={{ lessonPaths }}>
  function normKey(path) {
    return String(path).replace(/\/$/, "");
  }

  function completedPaths() {
    try {
      var raw = localStorage.getItem("ts-py-learning-progress");
      if (!raw) return [];
      var parsed = JSON.parse(raw);
      return Array.isArray(parsed.lessons)
        ? parsed.lessons.map(function (l) {
            return l.path;
          })
        : [];
    } catch (e) {
      return [];
    }
  }

  function isCompleted(path) {
    var completed = completedPaths().map(normKey);
    return completed.indexOf(normKey(path)) !== -1;
  }

  function addCompletionMarkers() {
    var known = new Map(
      lessonPaths.map(function (p) {
        return [normKey(p), p];
      }),
    );

    document.querySelectorAll(".sl-markdown-content a[href]").forEach(function (link) {
      var rawHref = link.getAttribute("href") || "";
      var resolved;
      try {
        resolved = normKey(new URL(rawHref, window.location.href).pathname);
      } catch (e) {
        return;
      }

      var raw = known.get(resolved);
      if (!raw) {
        for (var i = 0; i < lessonPaths.length; i += 1) {
          if (resolved.endsWith(normKey(lessonPaths[i]))) {
            raw = lessonPaths[i];
            break;
          }
        }
      }
      if (!raw) return;
      if (link.querySelector(".lesson-completion-marker")) return;

      var done = isCompleted(raw);
      var marker = document.createElement("span");
      marker.className = "lesson-completion-marker";
      marker.style.cssText =
        "display:inline-block;width:.5rem;height:.5rem;margin-inline-start:.35rem;border:1px solid var(--border-default);border-radius:2px;vertical-align:middle;";
      if (done) {
        marker.style.background = "var(--success)";
        marker.style.borderColor = "var(--success)";
      }
      marker.setAttribute("aria-label", done ? "已完成" : "未完成");
      marker.setAttribute("title", done ? "已完成" : "未完成");
      link.appendChild(marker);
    });
  }

  function schedule() {
    setTimeout(addCompletionMarkers, 60);
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", schedule);
  } else {
    schedule();
  }

  window.addEventListener("progress-updated", schedule);
  document.addEventListener("astro:page-load", schedule);
</script>
