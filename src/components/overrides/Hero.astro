---
/**
 * 首页 Hero 覆盖（Starlight 官方可覆盖组件）
 *
 * 2026-09-20 现代化重设计：默认 hero 是"居中标题 + 可选图片"的文档页版式，
 * 这里换成着陆页版式——左文右码两栏、aurora 光晕背景、渐变强调标题、
 * 规模统计与双语对照代码面板。数据全部构建期派生，页面不写死数量。
 *
 * 标题里的 <em class="hero-grad"> 渐变文字由 frontmatter hero.title 提供，
 * 其样式在全局 home.css（set:html 内容拿不到 scoped 属性）。
 */
import { getCollection, type CollectionEntry } from "astro:content";
import CodeCompare from "../CodeCompare.astro";
import { totalLessonCount } from "../../lib/curriculum";
import { QUIZZES } from "../../data/quizzes";

// Starlight 0.42 的覆盖组件从 Astro.locals.starlightRoute 取路由数据，
// Page.astro 渲染 Hero 时不透传 props（与官方默认 Hero 一致）
const { entry } = Astro.locals.starlightRoute;
const hero = entry.data.hero;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");

const lessonTotal = totalLessonCount();
const algorithms = await getCollection(
  "docs",
  (item: CollectionEntry<"docs">) =>
    item.id.startsWith("algorithms/") && item.data.kind === "algorithm"
);
const quizTotal = Object.values(QUIZZES).reduce((sum, list) => sum + list.length, 0);

const stats = [
  { label: "双语课程", value: `${lessonTotal} 节` },
  { label: "算法题解", value: `${algorithms.length} 道` },
  { label: "测验题目", value: `${quizTotal} 道` },
];
---

<div class="home-hero">
  <div class="home-hero__backdrop" aria-hidden="true">
    <span class="home-hero__glow home-hero__glow--a"></span>
    <span class="home-hero__glow home-hero__glow--b"></span>
    <span class="home-hero__grid"></span>
  </div>

  <div class="home-hero__inner">
    <div class="home-hero__copy">
      <p class="home-hero__badge">
        <span class="home-hero__badge-dot" aria-hidden="true"></span>
        为 Python 开发者打造的 TypeScript 学习平台
      </p>

      <h1 id="_top" data-page-title set:html={hero?.title ?? entry.data.title} />

      {hero?.tagline && <p class="home-hero__tagline" set:html={hero.tagline} />}

      <div class="home-hero__actions">
        <a class="btn btn--primary btn--lg" href={`${base}/paths/`}>从第一条路径开始</a>
        <a class="btn btn--lg" href={`${base}/algorithms/`}>直接刷题</a>
      </div>

      <dl class="home-hero__stats">
        {
          stats.map((item) => (
            <div class="home-hero__stat">
              <dt>{item.label}</dt>
              <dd>{item.value}</dd>
            </div>
          ))
        }
      </dl>
    </div>

    <div class="home-hero__panel">
      <CodeCompare
        py={`def process_user(user: dict) -> str:\n    return user["name"]  # 注解只是"建议"\n\nprocess_user({"age": 25})  # 运行时才 KeyError`}
        ts={`function processUser(user: { name: string }): string {\n  return user.name;\n}\n\nprocessUser({ age: 25 });\n// ~~~~~ 编译期直接报错`}
        caption="同一个函数：Python 的注解是建议，TypeScript 的注解是规则"
      />
    </div>
  </div>
</div>

<style>
  .home-hero {
    position: relative;
    padding-block: clamp(2rem, 0.5rem + 4vw, 4.5rem) clamp(1.5rem, 0.5rem + 2vw, 2.5rem);
  }

  /* ---------- 背景层：光晕 + 细网格，全部无交互 ---------- */

  .home-hero__backdrop {
    position: absolute;
    inset: calc(-1 * clamp(1.5rem, 0.5rem + 4vw, 4.5rem)) calc(-1 * var(--sl-content-pad-x)) auto;
    height: calc(100% + clamp(1.5rem, 0.5rem + 4vw, 4.5rem));
    overflow: clip;
    pointer-events: none;
  }

  .home-hero__glow {
    position: absolute;
    width: 34rem;
    height: 34rem;
    border-radius: 50%;
    filter: blur(96px);
    opacity: 0.3;
  }

  .home-hero__glow--a {
    top: -14rem;
    inset-inline-start: -10rem;
    background: radial-gradient(circle closest-side, var(--glow-a), transparent 70%);
  }

  .home-hero__glow--b {
    top: -6rem;
    inset-inline-end: -12rem;
    background: radial-gradient(circle closest-side, var(--glow-b), transparent 70%);
  }

  .home-hero__grid {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(to right, var(--border-subtle) 1px, transparent 1px),
      linear-gradient(to bottom, var(--border-subtle) 1px, transparent 1px);
    background-size: 2.75rem 2.75rem;
    opacity: 0.5;
    mask-image: radial-gradient(ellipse 90% 80% at 50% 0%, #000 0%, transparent 68%);
  }

  /* ---------- 主体：桌面左文右码，窄屏单栏 ---------- */

  .home-hero__inner {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-8);
    align-items: center;
  }

  @media (min-width: 62rem) {
    .home-hero__inner {
      grid-template-columns: minmax(0, 11fr) minmax(0, 9fr);
      gap: var(--space-12);
    }
  }

  .home-hero__copy {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-5);
  }

  .home-hero__badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5em;
    margin: 0;
    padding: 0.3rem 0.85rem;
    border: 1px solid var(--accent-border);
    border-radius: var(--radius-pill);
    background: var(--surface-glass);
    font-size: var(--text-xs);
    font-weight: var(--weight-medium);
    letter-spacing: var(--tracking-wide);
    color: var(--accent-ink);
  }

  .home-hero__badge-dot {
    width: 0.45rem;
    height: 0.45rem;
    border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 0 3px var(--accent-ring);
  }

  h1[data-page-title] {
    margin: 0;
    max-width: 14ch;
    font-family: var(--font-display);
    font-size: var(--text-4xl);
    font-weight: var(--weight-bold);
    line-height: 1.12;
    letter-spacing: var(--tracking-cjk);
    color: var(--text-strong);
    /* 断行由 frontmatter 标题里的 <br> 显式控制，不再交给 balance 折衷 */
  }

  .home-hero__tagline {
    margin: 0;
    max-width: 44ch;
    font-size: var(--text-lg);
    line-height: var(--leading-snug);
    color: var(--text-muted);
    text-wrap: pretty;
  }

  .home-hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-1);
  }

  .home-hero__stats {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-6);
    margin: var(--space-2) 0 0;
    padding-top: var(--space-4);
    border-top: 1px solid var(--border-subtle);
  }

  .home-hero__stat {
    display: flex;
    flex-direction: column-reverse;
    gap: 0.15rem;
  }

  .home-hero__stat dt {
    font-size: var(--text-xs);
    color: var(--text-faint);
  }

  .home-hero__stat dd {
    margin: 0;
    font-family: var(--font-display);
    font-size: var(--text-xl);
    font-weight: var(--weight-semibold);
    font-variant-numeric: tabular-nums;
    color: var(--text-strong);
  }

  /* ---------- 代码面板 ---------- */

  .home-hero__panel {
    min-width: 0;
    padding: var(--space-2);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-xl);
    background: var(--surface-glass);
    box-shadow: var(--shadow-lg);
  }

  /* hero 右栏只有约 30rem 宽：双栏对照会把代码行裁切到要横向滚动才看得全，
     这里强制上下堆叠（Python 在上），每栏拿满面板宽度 */
  .home-hero__panel :global(.code-compare__grid) {
    grid-template-columns: minmax(0, 1fr);
  }

  @media (max-width: 61.99rem) {
    .home-hero__panel {
      max-width: 34rem;
    }
  }
</style>
