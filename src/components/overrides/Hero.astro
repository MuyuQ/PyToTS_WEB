---
/**
 * 首页 Hero 覆盖（Starlight 官方可覆盖组件）
 *
 * V2 纸面手册：左侧标题与规模统计，右侧双语对照台。
 * 去掉现代化版的 aurora 光晕、玻璃面板与渐变文字，改用纸面、墨线、
 * 双语言色与版本页眉——像一本排版严谨的技术手册封面。
 */
import { getCollection, type CollectionEntry } from "astro:content";
import CodeCompare from "../CodeCompare.astro";
import { totalLessonCount } from "../../lib/curriculum";
import { QUIZZES } from "../../data/quizzes";

// Starlight 0.42 的覆盖组件从 Astro.locals.starlightRoute 取路由数据，
// Page.astro 渲染 Hero 时不透传 props（与官方默认 Hero 一致）
const { entry } = Astro.locals.starlightRoute;
const hero = entry.data.hero;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");

const lessonTotal = totalLessonCount();
const algorithms = await getCollection(
  "docs",
  (item: CollectionEntry<"docs">) =>
    item.id.startsWith("algorithms/") && item.data.kind === "algorithm"
);
const quizTotal = Object.values(QUIZZES).reduce((sum, list) => sum + list.length, 0);

const stats = [
  { label: "节课", note: "四条路径", value: `${lessonTotal}` },
  { label: "道算法题", note: "双语", value: `${algorithms.length}` },
  { label: "道测验题", note: "即时反馈", value: `${quizTotal}` },
];
---

<div class="home-hero">
  <div class="home-hero__masthead" aria-hidden="true">
    <span class="home-hero__masthead-brand">PyToTS · 双语技术手册</span>
    <span class="home-hero__masthead-rule"></span>
    <span class="home-hero__masthead-vol">Edition 02</span>
    <span class="home-hero__masthead-year">2026</span>
  </div>

  <div class="home-hero__inner">
    <div class="home-hero__copy">
      <p class="home-hero__eyebrow">
        <span class="home-hero__dot home-hero__dot--py" aria-hidden="true"></span>
        Python
        <span class="home-hero__arrow" aria-hidden="true">→</span>
        TypeScript
        <span class="home-hero__dot home-hero__dot--ts" aria-hidden="true"></span>
      </p>

      <h1 id="_top" data-page-title set:html={hero?.title ?? entry.data.title} />

      {hero?.tagline && <p class="home-hero__tagline" set:html={hero.tagline} />}

      <div class="home-hero__actions">
        <a class="btn btn--primary btn--lg" href={`${base}/paths/`}>开始学习</a>
        <a class="btn btn--lg" href={`${base}/algorithms/`}>直接刷题</a>
      </div>

      <dl class="home-hero__stats">
        {
          stats.map((item) => (
            <div class="home-hero__stat">
              <dt>
                {item.label}
                <span class="home-hero__stat-note"> · {item.note}</span>
              </dt>
              <dd>{item.value}</dd>
            </div>
          ))
        }
      </dl>
    </div>

    <div class="home-hero__panel">
      <div class="home-hero__panel-label">
        <span>同一段逻辑 / 两套规则</span>
        <span class="home-hero__panel-dots" aria-hidden="true">
          <span class="home-hero__dot home-hero__dot--py"></span>
          <span class="home-hero__dot home-hero__dot--ts"></span>
        </span>
      </div>
      <CodeCompare
        py={`def process_user(user: dict) -> str:\n    return user["name"]  # 只是建议\n\nprocess_user({"age": 25})  # 运行时才 KeyError`}
        ts={`function processUser(user: { name: string }): string {\n  return user.name;  // 编译期检查形状\n}\n\nprocessUser({ age: 25 });\n// Property 'name' is missing`}
        caption="Python 的注解是建议，TypeScript 的检查发生在编译期。"
      />
    </div>
  </div>
</div>

<style>
  .home-hero {
    padding-block: 0 clamp(2rem, 1rem + 3vw, 4rem);
  }

  /* ---------- 版本页眉 ---------- */

  .home-hero__masthead {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    padding-bottom: 0.6rem;
    border-bottom: 1px solid var(--border-subtle);
    color: var(--text-muted);
    font-family: var(--font-mono);
    font-size: 0.6rem;
    letter-spacing: 0.13em;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .home-hero__masthead-brand {
    overflow: hidden;
    color: var(--text-default);
    text-overflow: ellipsis;
  }

  .home-hero__masthead-rule {
    flex: 1;
    min-width: 1rem;
    height: 1px;
    background: var(--border-subtle);
  }

  .home-hero__masthead-vol {
    color: var(--lang-py);
  }

  .home-hero__masthead-year {
    color: var(--text-faint);
  }

  /* ---------- 主体：桌面左文右码，窄屏单栏 ---------- */

  .home-hero__inner {
    display: grid;
    grid-template-columns: minmax(0, 1.04fr) minmax(0, 0.96fr);
    gap: clamp(1.75rem, 4vw, 4rem);
    align-items: start;
    padding-top: clamp(1.75rem, 3.5vw, 3.25rem);
  }

  @media (max-width: 61.99rem) {
    .home-hero__inner {
      grid-template-columns: minmax(0, 1fr);
      gap: 2.25rem;
    }
  }

  .home-hero__copy {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .home-hero__eyebrow {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.45rem;
    margin: 0 0 1.1rem;
    color: var(--text-muted);
    font-family: var(--font-mono);
    font-size: 0.65rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .home-hero__dot {
    display: inline-block;
    width: 0.4rem;
    height: 0.4rem;
    flex: none;
  }

  .home-hero__dot--py {
    background: var(--lang-py);
  }

  .home-hero__dot--ts {
    background: var(--lang-ts);
  }

  .home-hero__arrow {
    color: var(--text-faint);
  }

  h1[data-page-title] {
    margin: 0;
    max-width: 10em;
    font-family: var(--font-display);
    font-size: clamp(2.5rem, 1.8rem + 3vw, 4.2rem);
    font-weight: var(--weight-bold);
    line-height: 1.04;
    letter-spacing: 0.005em;
    color: var(--text-strong);
  }

  .home-hero__tagline {
    margin: 1.4rem 0 0;
    max-width: 36ch;
    font-size: var(--text-md);
    line-height: var(--leading-normal);
    color: var(--text-default);
    text-wrap: pretty;
  }

  .home-hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-top: 1.9rem;
  }

  .home-hero__stats {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    width: 100%;
    margin: 2.4rem 0 0;
    padding-top: 0.9rem;
    border-top: 2px solid var(--text-strong);
  }

  .home-hero__stat {
    display: flex;
    flex-direction: column-reverse;
    gap: 0.35rem;
    min-width: 0;
    padding-right: 0.75rem;
  }

  .home-hero__stat + .home-hero__stat {
    padding-left: 1rem;
    border-left: 1px solid var(--border-subtle);
  }

  .home-hero__stat dt {
    color: var(--text-muted);
    font-family: var(--font-mono);
    font-size: 0.6rem;
    line-height: 1.5;
    letter-spacing: 0.06em;
  }

  .home-hero__stat-note {
    color: var(--text-faint);
  }

  .home-hero__stat dd {
    margin: 0;
    color: var(--text-strong);
    font-family: var(--font-display);
    font-size: 2rem;
    font-weight: var(--weight-bold);
    font-variant-numeric: tabular-nums;
    line-height: 1;
    letter-spacing: -0.02em;
  }

  /* ---------- 双语对照台 ---------- */

  .home-hero__panel {
    min-width: 0;
    padding: 0.75rem;
    border: 1px solid var(--border-strong);
    background: var(--surface-raised);
  }

  .home-hero__panel-label {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    margin-bottom: 0.65rem;
    color: var(--text-muted);
    font-family: var(--font-mono);
    font-size: 0.6rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .home-hero__panel-dots {
    display: inline-flex;
    gap: 0.25rem;
  }

  .home-hero__panel :global(.code-compare__caption) {
    font-size: var(--text-xs);
    color: var(--text-muted);
  }

  /* hero 右栏只有约 30rem 宽：双栏对照会把代码行裁切到要横向滚动才看得全，
     这里强制上下堆叠（Python 在上），每栏拿满面板宽度 */
  .home-hero__panel :global(.code-compare__grid) {
    grid-template-columns: minmax(0, 1fr);
  }

  @media (max-width: 61.99rem) {
    .home-hero__panel {
      max-width: 34rem;
    }
  }

  @media (max-width: 40rem) {
    .home-hero__stat-note {
      display: none;
    }

    .home-hero__panel :global(.code-compare__pane pre),
    .home-hero__panel :global(.code-compare__pane code) {
      font-size: 0.7rem;
    }
  }

  @media (max-width: 34rem) {
    h1[data-page-title] {
      font-size: clamp(1.95rem, 9vw, 2.5rem);
    }
  }
</style>
