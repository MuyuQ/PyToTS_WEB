---
import config from "virtual:starlight/user-config";
import type { Props } from "@astrojs/starlight/props";

import LanguageSelect from "virtual:starlight/components/LanguageSelect";
import Search from "virtual:starlight/components/Search";
import SiteTitle from "virtual:starlight/components/SiteTitle";
import SocialIcons from "virtual:starlight/components/SocialIcons";
import ThemeSelect from "virtual:starlight/components/ThemeSelect";
import SiteNav from "./SiteNav.astro";
import VisitRecorder from "./VisitRecorder.astro";

const shouldRenderSearch =
  config.pagefind || config.components.Search !== "@astrojs/starlight/components/Search.astro";
---

<div class="header sl-flex">
  <div class="title-wrapper sl-flex">
    <SiteTitle {...Astro.props} />
  </div>
  <SiteNav />
  <div class="sl-flex right-group">
    <div class="sl-flex social-icons">
      <SocialIcons {...Astro.props} />
    </div>
    {shouldRenderSearch && <Search {...Astro.props} />}
    <ThemeSelect {...Astro.props} />
    <LanguageSelect {...Astro.props} />
  </div>
  {/* 借顶栏做「每页都渲染」的挂载点，为首页继续学习卡片记录上次学到的位置 */}
  <VisitRecorder />
</div>

<style>
  /* 窄屏导航换到第二行，顶栏相应增高。
     行高固定（3.5rem + 2.75rem = 6.25rem），Starlight 的汉堡按钮
     才能可靠地钉在第二行右侧，而不是按 6.25rem 整体居中、骑在两行之间。 */
  @media (max-width: 61.99rem) {
    :global(:root) {
      --sl-nav-height: 6.25rem;
    }

    .header {
      display: grid;
      grid-template-columns: minmax(0, 1fr) auto;
      grid-template-rows: 3.5rem 2.75rem;
    }

    .header > :global(.site-nav) {
      grid-column: 1 / -1;
      grid-row: 2;
      align-self: center;
    }
  }

  .header {
    gap: var(--sl-nav-gap);
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    align-content: center;
    height: 100%;
    padding: 0 var(--space-4);
    background: var(--surface-nav);
    border-bottom: 1px solid var(--border-subtle);
  }

  .title-wrapper {
    overflow: hidden;
    flex-shrink: 0;
    min-width: 0;
  }

  .title-wrapper :global(.site-title) {
    font-family: var(--font-display);
    font-size: var(--text-lg);
    font-weight: var(--weight-semibold);
    letter-spacing: var(--tracking-tight);
    color: var(--text-strong);
    white-space: nowrap;
    text-decoration: none;
    transition: color var(--duration-fast) var(--ease-out-quart);
  }

  .title-wrapper :global(.site-title):hover {
    color: var(--accent);
  }

  .right-group {
    gap: var(--space-2);
    align-items: center;
    margin-left: auto;
    flex-shrink: 0;
  }

  .social-icons {
    gap: var(--space-2);
    align-items: center;
  }

  .social-icons:empty {
    display: none;
  }

  .social-icons::after {
    content: "";
    height: 1.5rem;
    border-inline-end: 1px solid var(--border-subtle);
  }

  .social-icons:empty::after {
    display: none;
  }

  @media (max-width: 30rem) {
    .header {
      padding: 0 var(--space-3);
      gap: var(--space-2);
    }

    .title-wrapper :global(.site-title) {
      font-size: var(--text-md);
    }
  }

  @media (min-width: 62rem) {
    .header {
      --__sidebar-width: max(0rem, var(--sl-content-inline-start, 0rem) - var(--sl-nav-pad-x));
      --__main-column-fr: calc(
        (
            100% + var(--__sidebar-pad, 0rem) - var(--__toc-width, var(--sl-sidebar-width)) -
              (2 * var(--__toc-width, var(--sl-nav-pad-x))) - var(--sl-content-inline-start, 0rem) -
              var(--sl-content-width)
          ) / 2
      );
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: var(--space-6);
    }

    .right-group {
      gap: var(--space-3);
    }
  }
</style>
