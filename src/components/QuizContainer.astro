---
/**
 * 编程测验容器（瘦身后只负责编排）
 *
 * 2026-09 拆分：题库数据 → src/data/quizzes.ts；交互逻辑 → src/lib/quiz-ui.ts；
 * 样式 → src/styles/quiz.css。本文件只剩模板与挂载点，
 * 改题目去 data 目录，改交互去 quiz-ui。
 */
import { questionsFor } from "../data/quizzes";
// 样式跟随组件打包：只有用到测验的页面才加载这一份
import "../styles/quiz.css";

interface Props {
  quizId: string;
}

const { quizId } = Astro.props;
const questions = questionsFor(quizId);
---

{
  questions.length === 0 ? (
    // quizId 拼错或题库被清空时给明确占位，而不是渲染一个判分时
    // 抛 TypeError 的空壳（questionsFor「空数组降级」契约在此兑现）
    <div class="quiz-container" role="region" aria-label="编程测验">
      <p class="quiz-empty">
        测验「{quizId}」暂无题目：quizId 与 src/data/quizzes.ts
        中的键不匹配，请修正页面引用或补录题目。
      </p>
    </div>
  ) : (
    <div
      class="quiz-container"
      data-quiz-id={quizId}
      role="region"
      aria-label="编程测验"
      tabindex="-1"
    >
      <div class="quiz-header">
        <span class="quiz-progress" aria-live="polite" />
      </div>
      <div class="quiz-question" role="heading" aria-level="3" />
      <div class="quiz-options" role="radiogroup" aria-label="选项" />
      <div
        class="quiz-explanation"
        style="display: none;"
        aria-live="polite"
        aria-atomic="true"
        tabindex="-1"
      />
      <div class="quiz-actions">
        <button class="quiz-action-btn" disabled aria-label="提交答案">
          提交答案
        </button>
      </div>
      <div class="quiz-result" style="display: none;" role="region" aria-label="测验结果" />
    </div>
  )
}

<script>
  import { initQuizContainers } from "../lib/quiz-ui";

  // Astro 的 <script> 是 module（defer 执行），DOM 此时已就绪，无需再等 DOMContentLoaded
  initQuizContainers();
  // Starlight 0.28 是 MPA 全页加载，astro:page-load 当前不会触发；
  // 保留监听，未来升级视图过渡后无需改动即可恢复行为
  document.addEventListener("astro:page-load", () => initQuizContainers());
</script>
