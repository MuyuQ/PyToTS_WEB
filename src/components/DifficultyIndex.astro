---
/**
 * 难度索引：按难度分组列出全部课程与算法题，构建时从内容集合生成。
 */
import { getCollection } from "astro:content";
import DifficultyBadge from "./DifficultyBadge.astro";
import { docSlug } from "../lib/doc-id";

const base = import.meta.env.BASE_URL.replace(/\/+$/, "");
const hrefFor = (id: string) => {
  const slug = docSlug(id);
  return slug ? `${base}/${slug}/` : `${base}/`;
};

const docs = await getCollection("docs", (entry) => {
  const { kind, difficulty } = entry.data;
  return (kind === "lesson" || kind === "algorithm") && Boolean(difficulty);
});

const GROUPS = [
  { difficulty: "easy", label: "入门" },
  { difficulty: "medium", label: "进阶" },
  { difficulty: "hard", label: "高阶" },
];

const KIND_LABELS: Record<string, string> = { lesson: "课程", algorithm: "算法" };

const byDifficulty = (difficulty: string) =>
  docs
    .filter((entry) => entry.data.difficulty === difficulty)
    .map((entry) => ({
      title: entry.data.title,
      kind: entry.data.kind ?? "page",
      href: hrefFor(entry.id),
    }))
    .sort((a, b) => a.title.localeCompare(b.title, "zh-Hans-CN"));
---

{
  GROUPS.map(({ difficulty, label }) => {
    const items = byDifficulty(difficulty);
    return (
      <section class="diff-group">
        <h2>
          {label} <span class="diff-count">{items.length} 篇</span>
        </h2>
        {items.length === 0 ? (
          <p class="diff-empty">暂无内容。</p>
        ) : (
          /* 整行即链接：命中区域大，右侧只放元数据，不抢标题的视觉重心 */
          <ul class="entry-list">
            {items.map(({ title, kind, href }) => (
              <li>
                <a href={href}>
                  <span class="diff-title">{title}</span>
                  <span class="diff-meta">
                    <span class="diff-kind">{KIND_LABELS[kind] ?? kind}</span>
                    <DifficultyBadge difficulty={difficulty} />
                  </span>
                </a>
              </li>
            ))}
          </ul>
        )}
      </section>
    );
  })
}

<style>
  .diff-group {
    margin: var(--section-gap) 0 0;
  }

  .diff-group h2 {
    display: flex;
    align-items: baseline;
    gap: var(--space-2);
    font-size: var(--text-xl);
    font-weight: var(--weight-semibold);
    letter-spacing: var(--tracking-cjk);
    margin: 0 0 var(--space-3);
    color: var(--text-strong);
  }

  .diff-count {
    font-size: var(--text-sm);
    font-weight: var(--weight-normal);
    color: var(--text-faint);
    font-variant-numeric: tabular-nums;
  }

  .diff-empty {
    margin: 0;
    color: var(--text-muted);
  }

  /* 标题占满剩余空间，元数据靠右对齐成一条竖线 */
  .diff-title {
    flex: 1;
    min-width: 0;
  }

  .diff-meta {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    flex-shrink: 0;
  }

  .diff-kind {
    font-size: var(--text-xs);
    color: var(--text-muted);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-pill);
    padding: 0 var(--space-2);
    line-height: 1.6;
  }
</style>
