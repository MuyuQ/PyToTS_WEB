---
/**
 * 学习进度与收藏面板
 *
 * 重构前「我的书签」页没有出现在任何导航里 —— 用户收藏后无处查看，功能闭环是断的。
 * 这里把它升级为「进度 + 收藏」的统一视图，并挂到顶层导航的「我的」。
 *
 * 全部数据来自 localStorage，课程清单来自 lib/curriculum.ts 与内容集合，
 * 页面本身不写死任何数量。
 */
import { getCollection, type CollectionEntry } from "astro:content";
import { TRACK_ORDER, TRACKS, trackLessonCount, lessonRoute, CURRICULUM } from "../lib/curriculum";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");

const algorithms = await getCollection(
  "docs",
  (entry: CollectionEntry<"docs">) =>
    entry.id.startsWith("algorithms/") && entry.data.kind === "algorithm"
);

const algorithmRoutes = algorithms.map((entry) => {
  const slug = entry.id.replace(/\.(mdx|md|)$/, "").replace(/(^|\/)index$/, "");
  return `/${slug}/`;
});

const tracks = TRACK_ORDER.map((id) => ({
  id,
  label: TRACKS[id].label,
  // 进度分母与课时数同口径：只计课时，不含路径入口页（与 SidebarProgress 一致）
  routes: CURRICULUM[id].filter((slug) => slug !== "index").map((slug) => lessonRoute(id, slug)),
  total: trackLessonCount(id),
  href: `${base}/paths/${id}/`,
}));
---

<section
  class="progress-panel"
  data-progress-panel
  data-base={base}
  data-tracks={JSON.stringify(tracks)}
  data-algorithms={JSON.stringify(algorithmRoutes)}
>
  <div class="stat-row" data-stat-row>
    <div class="stat">
      <span class="stat__value" data-stat="lessons">0</span>
      <span class="stat__label">已完成课程</span>
    </div>
    <div class="stat">
      <span class="stat__value" data-stat="algorithms">0</span>
      <span class="stat__label">已刷题目</span>
    </div>
    <div class="stat">
      <span class="stat__value" data-stat="quizzes">0</span>
      <span class="stat__label">测验次数</span>
    </div>
    <div class="stat">
      <span class="stat__value" data-stat="score">—</span>
      <span class="stat__label">平均正确率</span>
    </div>
  </div>

  <h3 class="progress-panel__heading">各路径进度</h3>

  <div class="track-progress" data-track-progress>
    {
      tracks.map((track) => (
        <div class="track-progress__row">
          <a class="track-progress__name" href={track.href}>
            {track.label}路径
          </a>
          <span class="track-progress__bar">
            <span class="track-progress__fill" data-track-fill style="width:0%" />
          </span>
          <span class="track-progress__num" data-track-num>
            0/{track.total}
          </span>
        </div>
      ))
    }
    <div class="track-progress__row">
      <a class="track-progress__name" href={`${base}/algorithms/`}>算法题库</a>
      <span class="track-progress__bar">
        <span class="track-progress__fill" data-track-fill style="width:0%"></span>
      </span>
      <span class="track-progress__num" data-track-num>0/{algorithmRoutes.length}</span>
    </div>
  </div>

  <h3 class="progress-panel__heading">我的收藏</h3>

  <div id="bookmarks-container" data-bookmarks>
    <p class="empty-state" data-bookmarks-empty hidden>
      还没有收藏。在课程或算法页点击「收藏」，之后就能在这里接着看。
    </p>
    <div class="bookmarks-grid" data-bookmarks-grid></div>
  </div>

  <h3 class="progress-panel__heading">备份与恢复</h3>

  <div class="backup-row">
    <p class="backup-note">
      进度只保存在当前设备的浏览器里。导出一份备份文件，换设备或清除缓存后可导入恢复；
      导入会与现有进度合并，两边都不会丢失。
    </p>
    <div class="backup-actions">
      <button type="button" class="btn btn--sm" data-export>导出进度</button>
      <label class="btn btn--sm backup-import">
        导入进度
        <input type="file" accept="application/json,.json" data-import hidden />
      </label>
    </div>
    <p class="backup-status" data-import-status role="status" aria-live="polite"></p>
  </div>

  <details class="danger-zone">
    <summary>清除本地数据</summary>
    <p>学习进度与收藏只保存在这台设备的浏览器里，不会上传。清除后无法恢复。</p>
    <button type="button" class="btn btn--sm" data-reset-step="idle">清除进度与收藏</button>
  </details>
</section>

<script>
  import {
    getProgress,
    setProgress,
    clearProgress,
    mergeLearningProgress,
    parseProgressBlob,
    normPath,
  } from "../lib/progress-store";

  /**
   * 课程与算法路由在构建时写入 data-*，脚本只从 DOM 读取：
   * 无需从 script 地址反推子路径 base，module script 也不经手构建期变量。
   */
  const panel = document.querySelector<HTMLElement>("[data-progress-panel]");
  const base = panel?.dataset.base || "";
  const tracks: { routes: string[] }[] = JSON.parse(panel?.dataset.tracks || "[]");
  const algorithmRoutes: string[] = JSON.parse(panel?.dataset.algorithms || "[]");

  // 收藏存的是不带 base 的规范路径（与 SidebarProgress 匹配口径一致），
  // 渲染成链接时必须补回子路径前缀，否则 /PyToTS_WEB/ 部署下点击会 404
  function withBase(path: string): string {
    if (!base || path === base || path.startsWith(base + "/")) return path;
    return base + path;
  }

  function completedSet(): Set<string> {
    return new Set(getProgress().lessons.map((item) => normPath(item.path)));
  }

  function paintStats(done: Set<string>): void {
    const root = document.querySelector<HTMLElement>("[data-progress-panel]");
    if (!root) return;

    const algorithmKeys = new Set(algorithmRoutes.map(normPath));
    let lessonsDone = 0;
    let algorithmsDone = 0;
    done.forEach((path) => {
      if (algorithmKeys.has(path)) algorithmsDone += 1;
      else lessonsDone += 1;
    });

    const progress = getProgress();
    const quizzes = progress.quizzes.length;
    const avg = quizzes
      ? Math.round(progress.quizzes.reduce((sum, q) => sum + (q.percentage || 0), 0) / quizzes)
      : null;

    const set = (name: string, value: string) => {
      const el = root.querySelector(`[data-stat="${name}"]`);
      if (el) el.textContent = value;
    };

    set("lessons", String(lessonsDone));
    set("algorithms", String(algorithmsDone));
    set("quizzes", String(quizzes));
    set("score", avg === null ? "—" : avg + "%");
  }

  function paintTracks(done: Set<string>): void {
    const root = document.querySelector("[data-track-progress]");
    if (!root) return;

    const groups = [...tracks.map((track) => track.routes), algorithmRoutes];

    const fills = root.querySelectorAll<HTMLElement>("[data-track-fill]");
    const nums = root.querySelectorAll<HTMLElement>("[data-track-num]");

    groups.forEach((routes, i) => {
      const hit = routes.filter((route) => done.has(normPath(route))).length;
      const pct = routes.length ? Math.round((hit / routes.length) * 100) : 0;
      if (fills[i]) fills[i].style.width = pct + "%";
      if (nums[i]) nums[i].textContent = hit + "/" + routes.length;
    });
  }

  function paintBookmarks(): void {
    const grid = document.querySelector("[data-bookmarks-grid]");
    const emptyEl = document.querySelector<HTMLElement>("[data-bookmarks-empty]");
    if (!grid) return;

    const marks = getProgress().bookmarks;
    grid.innerHTML = "";

    if (!marks.length) {
      if (emptyEl) emptyEl.hidden = false;
      return;
    }
    if (emptyEl) emptyEl.hidden = true;

    const completed = completedSet();

    marks.forEach((path) => {
      const title = normPath(path).split("/").filter(Boolean).pop() || path;
      const done = completed.has(normPath(path));

      const card = document.createElement("a");
      card.className = "bookmark-card";
      card.href = withBase(path);

      const head = document.createElement("div");
      head.className = "bookmark-header";

      const heading = document.createElement("span");
      heading.className = "bookmark-title";
      heading.textContent = decodeURIComponent(title);
      head.appendChild(heading);

      if (done) {
        const badge = document.createElement("span");
        badge.className = "completed-badge";
        badge.textContent = "已完成";
        head.appendChild(badge);
      }

      const sub = document.createElement("span");
      sub.className = "bookmark-path";
      sub.textContent = path;

      card.appendChild(head);
      card.appendChild(sub);
      grid.appendChild(card);
    });
  }

  function paint(): void {
    const done = completedSet();
    paintStats(done);
    paintTracks(done);
    paintBookmarks();
  }

  // ---------- 备份与恢复：导出 JSON / 导入合并 ----------
  const statusEl = document.querySelector<HTMLElement>("[data-import-status]");
  function setStatus(message: string): void {
    if (statusEl) statusEl.textContent = message;
  }

  const exportBtn = document.querySelector<HTMLButtonElement>("[data-export]");
  exportBtn?.addEventListener("click", () => {
    const progress = getProgress();
    const blob = new Blob([JSON.stringify(progress, null, 2)], { type: "application/json" });
    const url = URL.createObjectURL(blob);
    const anchor = document.createElement("a");
    anchor.href = url;
    anchor.download = `pytots-progress-${new Date().toISOString().slice(0, 10)}.json`;
    anchor.click();
    URL.revokeObjectURL(url);
    setStatus(`已导出 ${progress.lessons.length} 项进度与 ${progress.bookmarks.length} 条收藏。`);
  });

  const importInput = document.querySelector<HTMLInputElement>("[data-import]");
  importInput?.addEventListener("change", async () => {
    const file = importInput.files?.[0];
    if (!file) return;
    try {
      const incoming = parseProgressBlob(await file.text());
      if (!incoming) {
        setStatus("导入失败：文件不是有效的进度备份。");
        return;
      }
      const merged = mergeLearningProgress(getProgress(), incoming);
      setProgress(merged);
      setStatus(
        `导入成功：当前共 ${merged.lessons.length} 项进度、${merged.bookmarks.length} 条收藏。`
      );
      importInput.value = "";
    } catch {
      setStatus("导入失败：文件无法读取。");
    }
  });

  // 清除数据：两段式确认，避免误触导致不可逆丢失
  const resetBtn = document.querySelector<HTMLButtonElement>("[data-reset-step]");
  if (resetBtn) {
    let timer: ReturnType<typeof setTimeout> | null = null;
    resetBtn.addEventListener("click", () => {
      if (resetBtn.dataset.resetStep === "idle") {
        resetBtn.dataset.resetStep = "confirm";
        resetBtn.textContent = "再点一次，确认清除";
        timer = setTimeout(() => {
          resetBtn.dataset.resetStep = "idle";
          resetBtn.textContent = "清除进度与收藏";
        }, 4000);
        return;
      }

      if (timer) clearTimeout(timer);
      clearProgress();
      resetBtn.dataset.resetStep = "idle";
      resetBtn.textContent = "清除进度与收藏";
      paint();
      window.dispatchEvent(new CustomEvent("progress-updated"));
    });
  }

  function schedule(): void {
    setTimeout(paint, 50);
  }

  schedule();
  window.addEventListener("progress-updated", schedule);
  // Starlight 0.28 是 MPA 全页加载，astro:page-load 当前不会触发；保留监听以便未来升级视图过渡
  document.addEventListener("astro:page-load", schedule);
</script>

<style>
  .progress-panel {
    margin: var(--space-6) 0;
  }

  .progress-panel__heading {
    margin-top: var(--space-10);
    margin-bottom: var(--space-3);
    font-size: var(--text-md);
    font-weight: var(--weight-semibold);
    color: var(--text-muted);
    letter-spacing: var(--tracking-wide);
  }

  .stat-row {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-4);
    margin-bottom: var(--space-2);
  }

  @media (min-width: 48rem) {
    .stat-row {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  .stat {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    padding: var(--space-4);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
    background: var(--surface-raised);
  }

  .stat__value {
    font-family: var(--font-display);
    font-size: var(--text-2xl);
    font-weight: var(--weight-semibold);
    font-variant-numeric: tabular-nums;
    color: var(--text-strong);
    line-height: 1;
  }

  .stat__label {
    font-size: var(--text-xs);
    color: var(--text-faint);
  }

  .track-progress {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .track-progress__row {
    display: grid;
    grid-template-columns: 6rem 1fr 3.5rem;
    align-items: center;
    gap: var(--space-4);
  }

  .track-progress__name {
    font-size: var(--text-sm);
    font-weight: var(--weight-medium);
    color: var(--text-default);
    text-decoration: none;
  }

  .track-progress__name:hover {
    color: var(--accent);
  }

  .track-progress__bar {
    display: block;
    height: 0.375rem;
    border-radius: var(--radius-pill);
    background: var(--border-subtle);
    overflow: hidden;
  }

  .track-progress__fill {
    display: block;
    height: 100%;
    border-radius: var(--radius-pill);
    background: var(--accent);
    transition: width var(--duration-slow) var(--ease-out-quart);
  }

  .track-progress__num {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-variant-numeric: tabular-nums;
    color: var(--text-faint);
    text-align: end;
  }

  .backup-row {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    padding: var(--space-4);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
    background: var(--surface-raised);
  }

  .backup-note {
    margin: 0;
    font-size: var(--text-sm);
    line-height: var(--leading-snug);
    color: var(--text-muted);
  }

  .backup-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }

  .backup-import {
    cursor: pointer;
  }

  .backup-status {
    margin: 0;
    min-height: 1em;
    font-size: var(--text-xs);
    color: var(--accent-ink);
  }

  .danger-zone {
    margin-top: var(--space-12);
    padding: var(--space-4);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
    background: var(--surface-sunken);
  }

  .danger-zone summary {
    cursor: pointer;
    font-size: var(--text-sm);
    font-weight: var(--weight-semibold);
    color: var(--text-muted);
  }

  .danger-zone p {
    margin: var(--space-3) 0;
    font-size: var(--text-sm);
    color: var(--text-muted);
  }

  .danger-zone button[data-reset-step="confirm"] {
    border-color: var(--danger);
    background: var(--danger-quiet);
    color: var(--danger);
  }
</style>
