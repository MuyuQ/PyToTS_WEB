---
/**
 * 侧边栏学习进度
 *
 * 重构前这里内联了一份 36 道算法题的路径清单，与课程顺序一起硬编码在脚本里，
 * 新增题目必须手改本文件才会被标记。
 * 现在：课程顺序来自 lib/curriculum.ts，算法路由在构建时从内容集合读取，
 * 两者序列化后注入客户端脚本，内容变动自动跟随。
 */
import { getCollection, type CollectionEntry } from "astro:content";
import { TRACK_ORDER, TRACKS, trackRoutes, CURRICULUM, lessonRoute } from "../lib/curriculum";

const algorithms = await getCollection(
  "docs",
  (entry: CollectionEntry<"docs">) =>
    entry.id.startsWith("algorithms/") && entry.data.kind === "algorithm",
);

const algorithmRoutes = algorithms.map((entry) => {
  const slug = entry.id.replace(/\.(mdx|md)$/, "").replace(/(^|\/)index$/, "");
  return `/${slug}/`;
});

/** { 准备: [...], 基础: [...], ..., 算法: [...] } —— 分组进度用。
 *  口径与首页一致：只计课时，不含路径入口页。 */
const groups: Record<string, string[]> = Object.fromEntries(
  TRACK_ORDER.map((track) => [
    TRACKS[track].label,
    CURRICULUM[track]
      .filter((slug) => slug !== "index")
      .map((slug) => lessonRoute(track, slug)),
  ]),
);
groups["算法"] = algorithmRoutes;

/** 需要打点的全部路由 */
const allRoutes = [...TRACK_ORDER.flatMap((track) => trackRoutes(track)), ...algorithmRoutes];
---

<script is:inline define:vars={{ groups, allRoutes }}>
  var PROGRESS_KEY = "ts-py-learning-progress";
  var ALL_PATHS = allRoutes;
  var GROUP_PATHS = groups;

  // 子路径部署下 href 会带 base 前缀，存储的仍是站内路径：以后缀匹配兼容两种情况
  function matchesPath(href, path) {
    if (!href) return false;
    var bare = String(path).replace(/\/$/, "");
    return href === path || href === bare || href.endsWith(path) || href.endsWith(bare);
  }

  function getCurrentPath() {
    return ALL_PATHS.find(function (p) {
      return matchesPath(window.location.pathname, p);
    });
  }

  function readProgress() {
    try {
      var raw = localStorage.getItem(PROGRESS_KEY);
      if (!raw) return { lessons: [], quizzes: [], bookmarks: [], lastVisited: "" };
      var parsed = JSON.parse(raw);
      return {
        lessons: Array.isArray(parsed.lessons) ? parsed.lessons : [],
        quizzes: Array.isArray(parsed.quizzes) ? parsed.quizzes : [],
        bookmarks: Array.isArray(parsed.bookmarks) ? parsed.bookmarks : [],
        lastVisited: parsed.lastVisited || "",
      };
    } catch (e) {
      return { lessons: [], quizzes: [], bookmarks: [], lastVisited: "" };
    }
  }

  function completedPaths() {
    return readProgress().lessons.map(function (l) {
      return l.path;
    });
  }

  function isCompleted(path) {
    var completed = completedPaths();
    return completed.indexOf(path) !== -1 || completed.indexOf(path.replace(/\/$/, "")) !== -1;
  }

  function markCompleted(path) {
    try {
      var progress = readProgress();
      var exists = progress.lessons.some(function (l) {
        return l.path === path;
      });
      if (exists) return;

      var heading = document.querySelector("h1");
      progress.lessons.push({
        path: path,
        title: heading ? heading.textContent.trim() : "",
        completedAt: new Date().toISOString(),
        type: "lesson",
      });
      localStorage.setItem(PROGRESS_KEY, JSON.stringify(progress));
      window.dispatchEvent(new CustomEvent("progress-updated", { detail: progress }));
    } catch (e) {
      console.error("保存学习进度失败：", e);
    }
  }

  // 滚到正文末尾才算学完，避免刚打开就记完成
  function watchCompletion(path) {
    var marked = false;
    var retries = 0;
    var observer = null;

    function anchor() {
      var target = document.querySelector(".pagination-links") ||
        document.querySelector("footer") ||
        document.querySelector(".sl-markdown-content > *:last-child");

      if (!target && retries < 10) {
        retries += 1;
        setTimeout(anchor, 200);
        return;
      }
      if (!target) {
        var content = document.querySelector(".sl-markdown-content");
        target = content ? content.lastElementChild : null;
      }
      if (!target) return;

      observer = new IntersectionObserver(
        function (entries) {
          entries.forEach(function (entry) {
            if (entry.isIntersecting && !marked) {
              marked = true;
              markCompleted(path);
              if (observer) observer.disconnect();
            }
          });
        },
        { threshold: 0.1 },
      );
      observer.observe(target);
    }

    anchor();
  }

  function renderIndicators() {
    var sidebar = document.querySelector("nav.sidebar, .sl-sidebar, [data-sidebar]");
    if (!sidebar) return;

    // 幂等：先清掉上一轮渲染的标记
    sidebar.querySelectorAll(".progress-dot").forEach(function (el) {
      el.remove();
    });
    sidebar.querySelectorAll(".group-progress").forEach(function (el) {
      el.remove();
    });

    sidebar.querySelectorAll("a[href]").forEach(function (link) {
      if (link.querySelector(".progress-dot")) return;

      var href = link.getAttribute("href") || "";
      var matched = ALL_PATHS.find(function (path) {
        return matchesPath(href, path);
      });
      if (!matched) return;

      var done = isCompleted(matched);
      var dot = document.createElement("span");
      dot.className = "progress-dot" + (done ? " completed" : "");
      dot.textContent = done ? "已完成" : "未完成";
      dot.setAttribute("aria-label", done ? "已完成" : "未完成");
      dot.setAttribute("title", done ? "已完成" : "未完成");
      link.appendChild(dot);
    });

    Object.keys(GROUP_PATHS).forEach(function (groupKey) {
      var paths = GROUP_PATHS[groupKey] || [];
      var done = paths.filter(isCompleted).length;
      if (!paths.length) return;

      var firstLink = Array.prototype.find.call(
        sidebar.querySelectorAll("a[href]"),
        function (link) {
          return matchesPath(link.getAttribute("href") || "", paths[0]);
        },
      );
      if (!firstLink) return;

      var groupEl = firstLink.closest(".sl-sidebar-group, [data-sidebar-group], details");
      if (!groupEl) return;

      var toggle = groupEl.querySelector("button, summary, .sl-sidebar-group-toggle");
      if (!toggle || toggle.querySelector(".group-progress")) return;

      var badge = document.createElement("span");
      badge.className = "group-progress " + (done > 0 ? "has-progress" : "no-progress");
      badge.textContent = done + "/" + paths.length;
      badge.setAttribute("title", groupKey + "：" + done + " / " + paths.length + " 已完成");
      toggle.appendChild(badge);
    });
  }

  function init() {
    renderIndicators();
    var current = getCurrentPath();
    if (current) watchCompletion(current);
  }

  function schedule(fn) {
    return function () {
      setTimeout(fn, 100);
    };
  }

  window.addEventListener("progress-updated", schedule(renderIndicators));
  document.addEventListener("astro:page-load", schedule(init));

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", schedule(init));
  } else {
    schedule(init)();
  }
</script>
