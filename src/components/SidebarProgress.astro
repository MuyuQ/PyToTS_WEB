---
/**
 * 侧边栏学习进度
 *
 * 重构前这里内联了一份 36 道算法题的路径清单，与课程顺序一起硬编码在脚本里，
 * 新增题目必须手改本文件才会被标记。
 * 现在：课程顺序来自 lib/curriculum.ts，算法路由在构建时从内容集合读取，
 * 两者序列化后注入客户端脚本，内容变动自动跟随。
 */
import { getCollection, type CollectionEntry } from "astro:content";
import { TRACK_ORDER, TRACKS, trackRoutes, CURRICULUM, lessonRoute } from "../lib/curriculum";

const algorithms = await getCollection(
  "docs",
  (entry: CollectionEntry<"docs">) =>
    entry.id.startsWith("algorithms/") && entry.data.kind === "algorithm"
);

const algorithmRoutes = algorithms.map((entry) => {
  const slug = entry.id.replace(/\.(mdx|md)$/, "").replace(/(^|\/)index$/, "");
  return `/${slug}/`;
});

/** { 准备: [...], 基础: [...], ..., 算法: [...] } —— 分组进度用。
 *  口径与首页一致：只计课时，不含路径入口页。 */
const groups: Record<string, string[]> = Object.fromEntries(
  TRACK_ORDER.map((track) => [
    TRACKS[track].label,
    CURRICULUM[track].filter((slug) => slug !== "index").map((slug) => lessonRoute(track, slug)),
  ])
);
groups["算法"] = algorithmRoutes;

/** 需要打点的全部路由 */
const allRoutes = [...TRACK_ORDER.flatMap((track) => trackRoutes(track)), ...algorithmRoutes];
---

<script
  type="application/json"
  data-progress-routes
  set:html={JSON.stringify({ groups, allRoutes })}
/>

<script>
  import { getProgress, markAsCompleted, normPath } from "../lib/progress-store";

  /**
   * 路由清单在构建期写入 JSON payload，脚本只从 DOM 读取——
   * module script 拿不到构建期变量，也不该从 script 地址反推 base。
   */
  function payload(): { groups: Record<string, string[]>; allRoutes: string[] } {
    const el = document.querySelector<HTMLScriptElement>("script[data-progress-routes]");
    try {
      return JSON.parse(el?.textContent || "{}");
    } catch {
      return { groups: {}, allRoutes: [] };
    }
  }

  const { groups: GROUP_PATHS, allRoutes: ALL_PATHS } = payload();

  // 子路径部署下 href 会带 base 前缀，存储的仍是站内路径：以后缀匹配兼容两种情况
  function matchesPath(href: string | null, path: string): boolean {
    if (!href) return false;
    const bare = normPath(path);
    return href === path || href === bare || href.endsWith(path) || href.endsWith(bare);
  }

  function getCurrentPath(): string | undefined {
    return ALL_PATHS.find((p) => matchesPath(window.location.pathname, p));
  }

  function markCompleted(path: string): void {
    // 已存在则不动，避免重复记完成时刷新 completedAt
    if (getProgress().lessons.some((l) => normPath(l.path) === normPath(path))) return;

    const heading = document.querySelector("h1");
    const type = path.startsWith("/algorithms/") ? "algorithm" : "lesson";
    markAsCompleted(path, heading ? heading.textContent.trim() : "", type);
  }

  // 滚到正文末尾才算学完，避免刚打开就记完成
  function watchCompletion(path: string): void {
    let marked = false;
    let retries = 0;
    let observer: IntersectionObserver | null = null;

    function anchor(): void {
      let target =
        document.querySelector(".pagination-links") ||
        document.querySelector("footer") ||
        document.querySelector(".sl-markdown-content > *:last-child");

      if (!target && retries < 10) {
        retries += 1;
        setTimeout(anchor, 200);
        return;
      }
      if (!target) {
        const content = document.querySelector(".sl-markdown-content");
        target = content ? content.lastElementChild : null;
      }
      if (!target) return;

      observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting && !marked) {
              marked = true;
              markCompleted(path);
              observer?.disconnect();
            }
          });
        },
        { threshold: 0.1 }
      );
      observer.observe(target);
    }

    anchor();
  }

  function renderIndicators(): void {
    const sidebar = document.querySelector("nav.sidebar, .sl-sidebar, [data-sidebar]");
    if (!sidebar) return;

    // 幂等：先清掉上一轮渲染的标记
    sidebar.querySelectorAll(".progress-dot").forEach((el) => el.remove());
    sidebar.querySelectorAll(".group-progress").forEach((el) => el.remove());

    const completed = new Set(getProgress().lessons.map((l) => normPath(l.path)));

    sidebar.querySelectorAll("a[href]").forEach((link) => {
      if (link.querySelector(".progress-dot")) return;

      const href = link.getAttribute("href") || "";
      const matched = ALL_PATHS.find((path) => matchesPath(href, path));
      if (!matched) return;

      const done = completed.has(normPath(matched));
      const dot = document.createElement("span");
      dot.className = "progress-dot" + (done ? " completed" : "");
      dot.textContent = done ? "已完成" : "未完成";
      dot.setAttribute("aria-label", done ? "已完成" : "未完成");
      dot.setAttribute("title", done ? "已完成" : "未完成");
      link.appendChild(dot);
    });

    Object.keys(GROUP_PATHS).forEach((groupKey) => {
      const paths = GROUP_PATHS[groupKey] || [];
      if (!paths.length) return;
      const done = paths.filter((p) => completed.has(normPath(p))).length;

      const firstLink = Array.prototype.find.call(
        sidebar.querySelectorAll("a[href]"),
        (link: HTMLAnchorElement) => matchesPath(link.getAttribute("href"), paths[0])
      ) as HTMLAnchorElement | undefined;
      if (!firstLink) return;

      const groupEl = firstLink.closest(".sl-sidebar-group, [data-sidebar-group], details");
      if (!groupEl) return;

      const toggle = groupEl.querySelector("button, summary, .sl-sidebar-group-toggle");
      if (!toggle || toggle.querySelector(".group-progress")) return;

      const badge = document.createElement("span");
      badge.className = "group-progress " + (done > 0 ? "has-progress" : "no-progress");
      badge.textContent = done + "/" + paths.length;
      badge.setAttribute("title", groupKey + "：" + done + " / " + paths.length + " 已完成");
      toggle.appendChild(badge);
    });
  }

  function init(): void {
    renderIndicators();
    const current = getCurrentPath();
    if (current) watchCompletion(current);
  }

  function schedule(fn: () => void): () => void {
    return () => {
      setTimeout(fn, 100);
    };
  }

  window.addEventListener("progress-updated", schedule(renderIndicators));
  // Starlight 0.28 是 MPA 全页加载，astro:page-load 当前不会触发；
  // 保留监听，未来升级视图过渡后无需改动即可恢复行为
  document.addEventListener("astro:page-load", schedule(init));

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", schedule(init));
  } else {
    schedule(init)();
  }
</script>
