---
/**
 * 首页 · 学习路径清单
 *
 * 课时数、路径名、定位全部从 lib/curriculum.ts 与内容集合派生。
 * 重构前首页把「2 课 / 5 课 / 7 课 / 8 课」和级别标签写死在 Markdown 里，
 * 任何一次课程增删都会让首页说谎。
 *
 * 版式刻意不用四张同构卡片：课程是有顺序的，就该长得像一份课表。
 */
import { TRACK_ORDER, TRACKS, trackLessonCount, trackRoutes } from "../lib/curriculum";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");

interface TrackRow {
  index: string;
  id: string;
  label: string;
  pitch: string;
  lessons: number;
  href: string;
  routes: string[];
}

const rows: TrackRow[] = TRACK_ORDER.map((id, i) => ({
  index: String(i + 1).padStart(2, "0"),
  id,
  label: TRACKS[id].label,
  pitch: TRACKS[id].pitch,
  lessons: trackLessonCount(id),
  href: `${base}/paths/${id}/`,
  routes: trackRoutes(id),
}));

const total = rows.reduce((sum, row) => sum + row.lessons, 0);
---

<div class="path-list" data-path-list data-total={total}>
  {
    rows.map((row) => (
      <a class="path-row" href={row.href} data-path-row data-routes={row.routes.join("|")}>
        <span class="path-row__index" aria-hidden="true">
          {row.index}
        </span>

        <span class="path-row__main">
          <span class="path-row__title">
            {row.label}路径
            <span class="path-row__count">{row.lessons} 课</span>
          </span>
          <span class="path-row__pitch">{row.pitch}</span>
        </span>

        <span class="path-row__aside">
          <span class="path-row__progress" data-row-progress aria-hidden="true">
            <span class="path-row__bar">
              <span class="path-row__fill" style="width:0%"></span>
            </span>
            <span class="path-row__num" data-row-num>
              0/{row.lessons}
            </span>
          </span>
          <span class="path-row__arrow" aria-hidden="true">
            →
          </span>
        </span>
      </a>
    ))
  }
</div>

<script>
  const KEY = "ts-py-learning-progress";

  function completedSet(): Set<string> {
    try {
      const raw = localStorage.getItem(KEY);
      if (!raw) return new Set();
      const parsed = JSON.parse(raw);
      const list = Array.isArray(parsed?.lessons) ? parsed.lessons : [];
      return new Set(list.map((item: { path?: string }) => String(item?.path ?? "").replace(/\/$/, "")));
    } catch {
      return new Set();
    }
  }

  function paint() {
    const root = document.querySelector<HTMLElement>("[data-path-list]");
    if (!root) return;
    const done = completedSet();

    root.querySelectorAll<HTMLElement>("[data-path-row]").forEach((row) => {
      const routes = (row.dataset.routes || "").split("|").filter(Boolean);
      const hit = routes.filter((route) => done.has(route.replace(/\/$/, ""))).length;
      const pct = routes.length ? Math.round((hit / routes.length) * 100) : 0;

      const fill = row.querySelector<HTMLElement>(".path-row__fill");
      const num = row.querySelector<HTMLElement>("[data-row-num]");
      if (fill) fill.style.width = `${pct}%`;
      if (num) num.textContent = `${hit}/${routes.length}`;
      row.dataset.completed = hit === routes.length && routes.length > 0 ? "true" : "false";
    });
  }

  function schedule() {
    setTimeout(paint, 60);
  }

  schedule();
  window.addEventListener("progress-updated", schedule);
  document.addEventListener("astro:page-load", schedule);
</script>

<style>
  .path-list {
    display: flex;
    flex-direction: column;
    margin: var(--space-6) 0;
    border-top: 1px solid var(--border-subtle);
  }

  .path-row {
    display: grid;
    grid-template-columns: auto 1fr;
    grid-template-areas:
      "index main"
      ".     aside";
    align-items: start;
    gap: var(--space-2) var(--space-5);
    padding: var(--space-5) var(--space-2);
    border-bottom: 1px solid var(--border-subtle);
    text-decoration: none;
    color: inherit;
    transition: background-color var(--duration-fast) var(--ease-out-quart);
  }

  .path-row:hover {
    background: var(--surface-hover);
    text-decoration: none;
  }

  /* 学完的路径：序号变为实心，一眼区分"走过"与"没走过" */
  .path-row[data-completed="true"] .path-row__index {
    color: var(--success);
  }

  .path-row__index {
    grid-area: index;
    font-family: var(--font-display);
    font-size: var(--text-xl);
    font-weight: var(--weight-semibold);
    font-variant-numeric: tabular-nums;
    color: var(--text-faint);
    line-height: 1;
    padding-top: 0.1em;
    transition: color var(--duration-base) var(--ease-out-quart);
  }

  .path-row:hover .path-row__index {
    color: var(--accent);
  }

  .path-row__main {
    grid-area: main;
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    min-width: 0;
  }

  .path-row__title {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: var(--space-3);
    font-family: var(--font-display);
    font-size: var(--text-lg);
    font-weight: var(--weight-semibold);
    letter-spacing: var(--tracking-tight);
    color: var(--text-strong);
  }

  .path-row__count {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: var(--weight-medium);
    color: var(--text-faint);
    font-variant-numeric: tabular-nums;
  }

  .path-row__pitch {
    font-size: var(--text-sm);
    line-height: var(--leading-snug);
    color: var(--text-muted);
    max-width: 52ch;
  }

  .path-row__aside {
    grid-area: aside;
    display: flex;
    align-items: center;
    gap: var(--space-4);
  }

  .path-row__progress {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }

  .path-row__bar {
    display: block;
    width: 5rem;
    height: 0.25rem;
    border-radius: var(--radius-pill);
    background: var(--border-subtle);
    overflow: hidden;
  }

  .path-row__fill {
    display: block;
    height: 100%;
    border-radius: var(--radius-pill);
    background: var(--accent);
    transition: width var(--duration-slow) var(--ease-out-quart);
  }

  .path-row[data-completed="true"] .path-row__fill {
    background: var(--success);
  }

  .path-row__num {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-variant-numeric: tabular-nums;
    color: var(--text-faint);
  }

  .path-row__arrow {
    font-family: var(--font-mono);
    font-size: var(--text-lg);
    color: var(--text-faint);
    transition: transform var(--duration-base) var(--ease-out-quart);
  }

  .path-row:hover .path-row__arrow {
    color: var(--accent);
    transform: translateX(0.25em);
  }

  /* 宽屏：进度与箭头推到行尾，形成"课表"的稳定右边界 */
  @media (min-width: 48rem) {
    .path-row {
      grid-template-columns: auto 1fr auto;
      grid-template-areas: "index main aside";
      align-items: center;
      gap: var(--space-6);
      padding: var(--space-5) var(--space-4);
    }

    .path-row__aside {
      justify-content: flex-end;
      min-width: 12rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .path-row__arrow {
      transition: none;
    }
  }
</style>
