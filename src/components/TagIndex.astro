---
/**
 * 标签索引：从内容集合聚合 python_tags / ts_tags / 算法 tags，构建时生成，永远与内容一致。
 */
import { getCollection } from "astro:content";
import { docSlug } from "../lib/doc-id";

interface TagGroup {
  label: string;
  items: { tag: string; pages: { title: string; href: string }[] }[];
}

const base = import.meta.env.BASE_URL.replace(/\/+$/, "");
const hrefFor = (id: string) => {
  const slug = docSlug(id);
  return slug ? `${base}/${slug}/` : `${base}/`;
};

const docs = await getCollection("docs");

const groups: TagGroup[] = [
  { label: "Python 侧标签", key: "python_tags" },
  { label: "TypeScript 侧标签", key: "ts_tags" },
  { label: "算法标签", key: "tags" },
].map(({ label, key }) => {
  const map = new Map<string, { title: string; href: string }[]>();
  for (const entry of docs) {
    const tags = (entry.data as Record<string, unknown>)[key];
    if (!Array.isArray(tags)) continue;
    for (const tag of tags as string[]) {
      const list = map.get(tag) ?? [];
      list.push({ title: entry.data.title, href: hrefFor(entry.id) });
      map.set(tag, list);
    }
  }
  return {
    label,
    items: Array.from(map.entries())
      .map(([tag, pages]) => ({ tag, pages }))
      .sort((a, b) => b.pages.length - a.pages.length || a.tag.localeCompare(b.tag)),
  };
});
---

{
  groups.map((group) => (
    <section class="tag-group">
      <h2>
        {group.label} <span class="tag-total">{group.items.length} 个标签</span>
      </h2>
      {group.items.length === 0 ? (
        <p class="tag-empty">暂无标签。</p>
      ) : (
        <ul class="tag-grid">
          {group.items.map(({ tag, pages }) => (
            <li class="tag-card">
              <div class="tag-card__head">
                <code class="tag-name">{tag}</code>
                <span class="tag-count">{pages.length} 篇</span>
              </div>
              {/* 三篇以内直接铺开；再多就用原生 details 折叠，无 JS 也能用 */}
              {pages.length <= 3 ? (
                <ul class="entry-list tag-pages">
                  {pages.map((page) => (
                    <li>
                      <a href={page.href}>{page.title}</a>
                    </li>
                  ))}
                </ul>
              ) : (
                <details class="tag-pages-toggle">
                  <summary>展开 {pages.length} 篇内容</summary>
                  <ul class="entry-list tag-pages">
                    {pages.map((page) => (
                      <li>
                        <a href={page.href}>{page.title}</a>
                      </li>
                    ))}
                  </ul>
                </details>
              )}
            </li>
          ))}
        </ul>
      )}
    </section>
  ))
}

<style>
  .tag-group {
    margin: var(--section-gap) 0 0;
  }

  .tag-group h2 {
    display: flex;
    align-items: baseline;
    gap: var(--space-2);
    font-size: var(--text-xl);
    font-weight: var(--weight-semibold);
    letter-spacing: var(--tracking-cjk);
    margin: 0 0 var(--space-4);
    color: var(--text-strong);
  }

  .tag-total {
    font-size: var(--text-sm);
    font-weight: var(--weight-normal);
    color: var(--text-faint);
    font-variant-numeric: tabular-nums;
  }

  .tag-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(18rem, 1fr));
    gap: var(--space-3);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .tag-card {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    padding: var(--space-4);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-lg);
    background: var(--surface-raised);
  }

  .tag-card__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2);
  }

  .tag-name {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    font-weight: var(--weight-semibold);
    color: var(--accent-ink);
    background: var(--accent-quiet);
    padding: 0 var(--space-2);
    border-radius: var(--radius-sm);
    line-height: 1.7;
  }

  .tag-count {
    flex-shrink: 0;
    font-size: var(--text-xs);
    color: var(--text-faint);
    font-variant-numeric: tabular-nums;
  }

  /* 卡片内的链接列表：去掉外边距，让它贴着卡片头部 */
  .tag-pages {
    margin: 0;
  }

  .tag-pages a {
    font-size: var(--text-sm);
  }

  .tag-pages-toggle summary {
    cursor: pointer;
    font-size: var(--text-sm);
    color: var(--text-muted);
    padding: var(--space-1) 0;
    list-style: none;
  }

  .tag-pages-toggle summary::-webkit-details-marker {
    display: none;
  }

  .tag-pages-toggle summary::before {
    content: "▸ ";
    color: var(--text-faint);
  }

  .tag-pages-toggle[open] summary::before {
    content: "▾ ";
  }

  .tag-pages-toggle summary:hover {
    color: var(--accent);
  }

  .tag-empty {
    margin: 0;
    color: var(--text-muted);
  }
</style>
