---
/**
 * 书签开关：课程/算法页一键收藏，状态经 progress-store 持久化到 localStorage。
 * 存储的 path 为去掉 base 前缀的原始路径（子路径部署下可移植）。
 */
interface Props {
  path: string;
}

const { path } = Astro.props;
---

<button
  type="button"
  class="bookmark-toggle"
  data-bookmark-path={path}
  aria-pressed="false"
  title="收藏本页"
>
  <svg
    class="bookmark-icon"
    viewBox="0 0 16 16"
    width="12"
    height="12"
    aria-hidden="true"
    fill="currentColor"
  >
    <path
      d="M3 2.5A1.5 1.5 0 0 1 4.5 1h7A1.5 1.5 0 0 1 13 2.5v11.1a.5.5 0 0 1-.78.42L8 11.14 3.78 13.92A.5.5 0 0 1 3 13.5V2.5Z"
    ></path>
  </svg>
  <span class="bookmark-label">收藏</span>
</button>

<script>
  import { addBookmark, removeBookmark, isBookmarked } from "../lib/progress-store";

  function syncToggle(btn: HTMLButtonElement) {
    const path = btn.dataset.bookmarkPath ?? "";
    const active = isBookmarked(path);
    btn.setAttribute("aria-pressed", active ? "true" : "false");
    btn.classList.toggle("is-active", active);
    const label = btn.querySelector(".bookmark-label");
    if (label) label.textContent = active ? "已收藏" : "收藏";
  }

  function initBookmarkToggles() {
    document
      .querySelectorAll<HTMLButtonElement>(".bookmark-toggle:not([data-init])")
      .forEach((btn) => {
        btn.dataset.init = "true";
        syncToggle(btn);
        btn.addEventListener("click", () => {
          const path = btn.dataset.bookmarkPath ?? "";
          if (isBookmarked(path)) removeBookmark(path);
          else addBookmark(path);
          syncToggle(btn);
        });
      });
  }

  initBookmarkToggles();
  document.addEventListener("astro:page-load", initBookmarkToggles);
  window.addEventListener("progress-updated", () => {
    document
      .querySelectorAll<HTMLButtonElement>(".bookmark-toggle")
      .forEach(syncToggle);
  });
</script>

<style>
  .bookmark-toggle {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    padding: 0.0625rem 0.625rem;
    border-radius: var(--radius-pill);
    border: 1px solid var(--border-subtle);
    background: var(--surface-sunken);
    color: var(--text-muted);
    font-size: 0.75rem;
    font-weight: 500;
    line-height: 1.6;
    white-space: nowrap;
    cursor: pointer;
  }

  .bookmark-toggle:hover {
    color: var(--accent);
    border-color: var(--accent);
  }

  .bookmark-toggle.is-active {
    color: var(--accent);
    border-color: var(--accent);
    background: var(--accent-quiet);
    font-weight: 600;
  }

  .bookmark-icon {
    flex-shrink: 0;
  }
</style>
