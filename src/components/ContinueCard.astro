---
/**
 * 首页「继续学习」卡片
 *
 * 服务端先渲染「起点推荐」，客户端读到学习记录后再换成「继续上次」。
 * 之所以不默认留空：空卡片会在 JS 执行后突然撑开，造成布局跳动；
 * 而「起点推荐」对新访客本身就是有用的入口。
 */
import { learningRoutes } from "../lib/learning-routes";
import { CURRICULUM, lessonRoute, totalLessonCount } from "../lib/curriculum";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const routes = await learningRoutes();

// 起点固定取准备篇第一课：routes 按路由字母序排，/algorithms/ 会排到 /paths/ 前面，
// 取 routes[0] 会指到算法题，那是「练」不是「学」。
const firstLesson = CURRICULUM.preparation
  .filter((slug) => slug !== "index")
  .map((slug) => lessonRoute("preparation", slug))[0];
const start = routes.find((r) => r.route === firstLesson) ?? routes[0];
const total = totalLessonCount();
---

<aside class="continue-card" data-continue-card data-routes={JSON.stringify(routes)}>
  <div class="continue-card__head">
    <span class="continue-card__label" data-continue-label>从这里开始</span>
    <span class="continue-card__meta" data-continue-meta>共 {total} 课</span>
  </div>
  <a class="continue-card__link" data-continue-link href={`${base}${start.route}`}>
    <span data-continue-title>{start.title}</span>
    <span class="continue-card__arrow" aria-hidden="true">→</span>
  </a>
  <p class="continue-card__hint" data-continue-hint>还没有学习记录，从准备篇开始最省事。</p>
</aside>

<script>
  import { getProgress } from "../lib/progress-store";

  const card = document.querySelector<HTMLElement>("[data-continue-card]");
  if (card) {
    const routes = JSON.parse(card.dataset.routes || "[]") as {
      route: string;
      title: string;
      kind: string;
    }[];
    const base = import.meta.env.BASE_URL.replace(/\/$/, "");

    const label = card.querySelector<HTMLElement>("[data-continue-label]");
    const link = card.querySelector<HTMLAnchorElement>("[data-continue-link]");
    const titleEl = card.querySelector<HTMLElement>("[data-continue-title]");
    const hint = card.querySelector<HTMLElement>("[data-continue-hint]");
    const meta = card.querySelector<HTMLElement>("[data-continue-meta]");

    const progress = getProgress();
    const last = progress.lastVisited
      ? routes.find((r) => r.route === progress.lastVisited)
      : undefined;

    if (last && link && titleEl) {
      if (label) label.textContent = "继续上次";
      titleEl.textContent = last.title;
      link.href = `${base}${last.route}`;
      if (meta) meta.textContent = last.kind === "algorithm" ? "算法题" : "课程";
      if (hint) {
        const done = progress.lessons.length;
        hint.textContent =
          done > 0 ? `已完成 ${done} 项，接着往下走。` : "上次看到这里，接着往下走。";
      }
      card.dataset.hasProgress = "true";
    }
  }
</script>

<style>
  .continue-card {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    margin: var(--space-6) 0 0;
    padding: var(--space-4) var(--space-5);
    border: 1px solid var(--accent-border);
    border-inline-start: 3px solid var(--accent);
    border-radius: var(--radius-lg);
    background: var(--accent-quiet);
  }

  /* 有进度时换成实心强调底，作为当天的行动入口更醒目 */
  .continue-card[data-has-progress="true"] {
    background: var(--surface-raised);
    border-color: var(--accent-border);
  }

  .continue-card__head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-3);
  }

  .continue-card__label {
    font-size: var(--text-xs);
    font-weight: var(--weight-semibold);
    letter-spacing: var(--tracking-wide);
    color: var(--accent-ink);
    text-transform: uppercase;
  }

  .continue-card__meta {
    font-size: var(--text-xs);
    color: var(--text-faint);
    font-variant-numeric: tabular-nums;
  }

  .continue-card__link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    font-family: var(--font-display);
    font-size: var(--text-lg);
    font-weight: var(--weight-semibold);
    letter-spacing: var(--tracking-cjk);
    color: var(--text-strong);
    text-decoration: none;
  }

  .continue-card__link:hover {
    color: var(--accent);
    text-decoration: none;
  }

  .continue-card__arrow {
    flex-shrink: 0;
    font-size: var(--text-md);
    color: var(--accent);
    transition: transform var(--duration-fast) var(--ease-out-quart);
  }

  .continue-card__link:hover .continue-card__arrow {
    transform: translateX(0.25rem);
  }

  .continue-card__hint {
    margin: 0;
    font-size: var(--text-sm);
    color: var(--text-muted);
  }
</style>
