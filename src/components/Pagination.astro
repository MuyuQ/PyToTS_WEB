---
/**
 * 分页（上一课/下一课 · 上一题/下一题）
 *
 * 顺序不再来自侧边栏，也不再依赖手写标题映射表：
 *   课程 → curriculum.ts 的教学顺序 + 内容集合里的标题
 *   算法 → 难度递进顺序（见 lib/neighbours.ts）
 * 其余页面回落到 Starlight 默认（侧边栏顺序）。
 */
import type { StarlightRouteData } from "@astrojs/starlight/route-data";
import {
  getLessonNeighbours,
  getAlgorithmNeighbours,
  getSimilarAlgorithms,
  stripBase,
} from "../lib/neighbours";

interface PaginationLink {
  href: string;
  label: string;
}

// Starlight 0.32+：覆盖组件从 Astro.locals.starlightRoute 取路由数据（props 已废弃）
const { dir, pagination } = Astro.locals.starlightRoute as StarlightRouteData;
const { prev: defaultPrev, next: defaultNext } = pagination ?? {};

const route = stripBase(Astro.url.pathname);
const isAlgorithm = route.startsWith("/algorithms/") && route !== "/algorithms/";

// 显式收窄为本组件实际使用的字段（starlight 的 SidebarLink 结构更宽）
let prev: PaginationLink | undefined = defaultPrev;
let next: PaginationLink | undefined = defaultNext;
let prevLabel = "上一页";
let nextLabel = "下一页";
let peers: { href: string; label: string }[] = [];

if (isAlgorithm) {
  const [neighbours, similar] = await Promise.all([
    getAlgorithmNeighbours(route),
    getSimilarAlgorithms(route),
  ]);
  prev = neighbours.prev;
  next = neighbours.next;
  prevLabel = "上一题";
  nextLabel = "下一题";
  peers = similar;
} else {
  const neighbours = await getLessonNeighbours(route);
  // 只在路径内确实找到邻居时覆盖，避免把普通页面的默认分页清空
  if (neighbours.prev || neighbours.next) {
    prev = neighbours.prev;
    next = neighbours.next;
    prevLabel = "上一课";
    nextLabel = "下一课";
  }
}
---

{
  peers.length > 0 && (
    <section class="algo-peers">
      <h2 class="algo-peers__title">同难度的其他题</h2>
      <p class="algo-peers__note">
        「下一题」是往上升一档；这里是同一档里的其他题，想多练几道再走就用它。
      </p>
      <ul class="algo-peers__list">
        {peers.map((peer) => (
          <li>
            <a href={peer.href}>
              <span class="algo-peers__name">{peer.label}</span>
              <span class="algo-peers__arrow" aria-hidden="true">
                →
              </span>
            </a>
          </li>
        ))}
      </ul>
    </section>
  )
}

{
  (prev || next) && (
    <div class="pagination-links print:hidden" dir={dir}>
      {prev ? (
        <a href={prev.href} rel="prev">
          <span class="pagination-arrow" aria-hidden="true">
            ←
          </span>
          <span>
            <span class="pagination-label">{prevLabel}</span>
            <span class="link-title">{prev.label}</span>
          </span>
        </a>
      ) : (
        <span />
      )}
      {next ? (
        <a href={next.href} rel="next">
          <span>
            <span class="pagination-label">{nextLabel}</span>
            <span class="link-title">{next.label}</span>
          </span>
          <span class="pagination-arrow" aria-hidden="true">
            →
          </span>
        </a>
      ) : (
        <span />
      )}
    </div>
  )
}
