---
/**
 * 分页（上一课/下一课 · 上一题/下一题）
 *
 * 顺序不再来自侧边栏，也不再依赖手写标题映射表：
 *   课程 → curriculum.ts 的教学顺序 + 内容集合里的标题
 *   算法 → 难度递进顺序（见 lib/neighbours.ts）
 * 其余页面回落到 Starlight 默认（侧边栏顺序）。
 */
import { getLessonNeighbours, getAlgorithmNeighbours, stripBase } from "../lib/neighbours";

interface PaginationLink {
  href: string;
  label: string;
}

interface Props {
  dir: "ltr" | "rtl";
  pagination: {
    prev: PaginationLink | undefined;
    next: PaginationLink | undefined;
  };
}

const { dir, pagination } = Astro.props as Props;
const { prev: defaultPrev, next: defaultNext } = pagination;

const route = stripBase(Astro.url.pathname);
const isAlgorithm = route.startsWith("/algorithms/") && route !== "/algorithms/";

let prev = defaultPrev;
let next = defaultNext;
let prevLabel = "上一页";
let nextLabel = "下一页";

if (isAlgorithm) {
  const neighbours = await getAlgorithmNeighbours(route);
  prev = (neighbours.prev as PaginationLink) ?? undefined;
  next = (neighbours.next as PaginationLink) ?? undefined;
  prevLabel = "上一题";
  nextLabel = "下一题";
} else {
  const neighbours = await getLessonNeighbours(route);
  // 只在路径内确实找到邻居时覆盖，避免把普通页面的默认分页清空
  if (neighbours.prev || neighbours.next) {
    prev = (neighbours.prev as PaginationLink) ?? undefined;
    next = (neighbours.next as PaginationLink) ?? undefined;
    prevLabel = "上一课";
    nextLabel = "下一课";
  }
}
---

{
  (prev || next) && (
    <div class="pagination-links print:hidden" dir={dir}>
      {prev ? (
        <a href={prev.href} rel="prev">
          <span class="pagination-arrow" aria-hidden="true">
            ←
          </span>
          <span>
            <span class="pagination-label">{prevLabel}</span>
            <span class="link-title">{prev.label}</span>
          </span>
        </a>
      ) : (
        <span />
      )}
      {next ? (
        <a href={next.href} rel="next">
          <span>
            <span class="pagination-label">{nextLabel}</span>
            <span class="link-title">{next.label}</span>
          </span>
          <span class="pagination-arrow" aria-hidden="true">
            →
          </span>
        </a>
      ) : (
        <span />
      )}
    </div>
  )
}
