---
/**
 * 算法题库索引：构建时从内容集合生成，支持按难度筛选与标题检索（纯客户端，无框架）。
 */
import type { CollectionEntry } from 'astro:content';
import { getCollection } from 'astro:content';
import DifficultyBadge from './DifficultyBadge.astro';

interface AlgorithmEntry {
  title: string;
  slug: string;
  difficulty: string;
  tags: string[];
  time: string;
  space: string;
}

const base = import.meta.env.BASE_URL.replace(/\/+$/, "");

// Astro 4 内容集合的 entry.id 保留扩展名（如 algorithms/3sum.mdx），统一归一为路由 slug
const slugFor = (id: string) => id.replace(/\.(mdx|md)$/, "").replace(/(^|\/)index$/, "");

const entries = await getCollection(
  'docs',
  (entry: CollectionEntry<'docs'>) =>
    entry.id.startsWith('algorithms/') && entry.data.kind === 'algorithm',
);

const DIFFICULTY_ORDER: Record<string, number> = { easy: 0, medium: 1, hard: 2 };

const algorithms: AlgorithmEntry[] = entries
  .map((entry) => ({
    title: entry.data.title,
    slug: slugFor(entry.id).replace(/^algorithms\//, ''),
    difficulty: entry.data.difficulty ?? 'medium',
    tags: entry.data.tags ?? [],
    time: entry.data.time_complexity ?? '',
    space: entry.data.space_complexity ?? '',
  }))
  .sort(
    (a, b) =>
      (DIFFICULTY_ORDER[a.difficulty] ?? 9) - (DIFFICULTY_ORDER[b.difficulty] ?? 9) ||
      a.title.localeCompare(b.title, 'zh-Hans-CN'),
  );

const countBy = (d: string) => algorithms.filter((a) => a.difficulty === d).length;
---

<section class="algo-index" data-algo-index>
  <div class="algo-index__controls">
    <div class="algo-index__filters" role="group" aria-label="按难度筛选">
      <button type="button" class="filter-btn is-active" data-filter="all">
        全部 <span class="filter-count">{algorithms.length}</span>
      </button>
      <button type="button" class="filter-btn" data-filter="easy">
        入门 <span class="filter-count">{countBy('easy')}</span>
      </button>
      <button type="button" class="filter-btn" data-filter="medium">
        进阶 <span class="filter-count">{countBy('medium')}</span>
      </button>
      <button type="button" class="filter-btn" data-filter="hard">
        高阶 <span class="filter-count">{countBy('hard')}</span>
      </button>
    </div>
    <label class="algo-index__search">
      <span class="sr-only">搜索算法题</span>
      <input type="search" placeholder="搜索题名或标签…" data-algo-search />
    </label>
  </div>

  <div class="algo-index__table-wrap">
    <table>
      <thead>
        <tr>
          <th scope="col">题目</th>
          <th scope="col">难度</th>
          <th scope="col">标签</th>
          <th scope="col">时间</th>
          <th scope="col">空间</th>
        </tr>
      </thead>
      <tbody>
        {
          algorithms.map((a) => (
            <tr
              data-difficulty={a.difficulty}
              data-search={`${a.title} ${a.tags.join(' ')}`.toLowerCase()}
            >
              <td>
                <a href={`${base}/algorithms/${a.slug}/`} class="algo-link">
                  {a.title}
                </a>
              </td>
              <td>
                <DifficultyBadge difficulty={a.difficulty} />
              </td>
              <td class="algo-tags">{a.tags.join(' · ')}</td>
              <td class="algo-complexity">{a.time}</td>
              <td class="algo-complexity">{a.space}</td>
            </tr>
          ))
        }
      </tbody>
    </table>
    <p class="algo-index__empty" data-algo-empty hidden>
      没有匹配的题目。换个关键词或清除筛选试试。
    </p>
  </div>
</section>

<style>
  .algo-index__controls {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    align-items: center;
    justify-content: space-between;
    margin: 1.5rem 0;
  }

  .algo-index__filters {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem;
  }

  .filter-btn {
    border: 1px solid var(--border-subtle);
    background: var(--surface-page);
    color: var(--text-muted);
    border-radius: var(--radius-pill);
    padding: 0.25rem 0.75rem;
    font-size: 0.8125rem;
    font-weight: 500;
    cursor: pointer;
    transition:
      color var(--duration-fast) var(--ease-out-quart),
      border-color var(--duration-fast) var(--ease-out-quart),
      background var(--duration-fast) var(--ease-out-quart);
  }

  .filter-btn:hover {
    color: var(--accent);
    border-color: var(--accent);
  }

  .filter-btn.is-active {
    background: var(--accent-quiet);
    border-color: var(--accent);
    color: var(--accent);
    font-weight: 600;
  }

  .filter-count {
    opacity: 0.65;
    font-weight: 400;
    margin-left: 0.125rem;
  }

  .algo-index__search input {
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
    background: var(--surface-page);
    color: var(--text-strong);
    padding: 0.375rem 0.75rem;
    font-size: 0.875rem;
    width: 14rem;
    max-width: 100%;
  }

  .algo-index__search input::placeholder {
    color: var(--text-muted);
  }

  .algo-index__search input:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 1px;
  }

  .algo-index__table-wrap {
    overflow-x: auto;
  }

  table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.875rem;
    /* 固定布局：标签列再长也不挤压题目列 */
    table-layout: fixed;
  }

  th:nth-of-type(1),
  td:nth-of-type(1) {
    width: 34%;
  }

  th:nth-of-type(2),
  td:nth-of-type(2) {
    width: 11%;
  }

  th:nth-of-type(3),
  td:nth-of-type(3) {
    width: 35%;
  }

  th:nth-of-type(4),
  td:nth-of-type(4),
  th:nth-of-type(5),
  td:nth-of-type(5) {
    width: 10%;
  }

  th {
    text-align: left;
    padding: 0.5rem 0.75rem;
    border-bottom: 2px solid var(--border-subtle);
    color: var(--text-muted);
    font-weight: 600;
    white-space: nowrap;
  }

  td {
    padding: 0.5625rem 0.75rem;
    border-bottom: 1px solid var(--border-subtle);
  }

  tbody tr:hover td {
    background: var(--accent-quiet);
  }

  .algo-link {
    color: var(--text-strong);
    text-decoration: none;
    font-weight: 500;
  }

  .algo-link:hover {
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .algo-tags {
    color: var(--text-muted);
    font-size: 0.8125rem;
  }

  .algo-complexity {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--text-muted);
    white-space: nowrap;
  }

  .algo-index__empty {
    padding: 1.5rem 0.75rem;
    color: var(--text-muted);
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
    border: 0;
  }
</style>

<script>
  function initAlgoIndex() {
    const root = document.querySelector<HTMLElement>('[data-algo-index]');
    if (!root || root.dataset.init) return;
    root.dataset.init = '1';

    const rows = Array.from(root.querySelectorAll<HTMLTableRowElement>('tbody tr'));
    const buttons = Array.from(root.querySelectorAll<HTMLButtonElement>('.filter-btn'));
    const search = root.querySelector<HTMLInputElement>('[data-algo-search]');
    const empty = root.querySelector<HTMLElement>('[data-algo-empty]');
    let filter = 'all';

    function apply() {
      const query = (search?.value ?? '').trim().toLowerCase();
      let visible = 0;
      for (const row of rows) {
        const matchFilter = filter === 'all' || row.dataset.difficulty === filter;
        const matchQuery = !query || (row.dataset.search ?? '').includes(query);
        const show = matchFilter && matchQuery;
        row.hidden = !show;
        if (show) visible += 1;
      }
      if (empty) empty.hidden = visible > 0;
    }

    for (const button of buttons) {
      button.addEventListener('click', () => {
        filter = button.dataset.filter ?? 'all';
        for (const b of buttons) b.classList.toggle('is-active', b === button);
        apply();
      });
    }

    search?.addEventListener('input', apply);
  }

  document.addEventListener('astro:page-load', initAlgoIndex);
  if (document.readyState !== 'loading') {
    initAlgoIndex();
  }
</script>
