---
/**
 * 难度徽标：入门 / 进阶 / 高阶
 *
 * 配色走语义令牌（success / warning / danger），亮暗两套自动跟随，
 * 不再为每种难度各写一组 hex。三档只差色相，不差明度。
 */
const LABELS: Record<string, string> = {
  easy: "入门",
  medium: "进阶",
  hard: "高阶",
};

/** 难度 → 语义色角色 */
const TONE: Record<string, "success" | "warning" | "danger"> = {
  easy: "success",
  medium: "warning",
  hard: "danger",
};

interface Props {
  difficulty?: string;
}

const { difficulty } = Astro.props;
if (!difficulty || !(difficulty in LABELS)) return null;
---

<span class={`diff-badge diff-badge--${TONE[difficulty]}`}>{LABELS[difficulty]}</span>

<style>
  .diff-badge {
    display: inline-flex;
    align-items: center;
    padding: 0 0.5rem;
    border-radius: var(--radius-pill);
    border: 1px solid transparent;
    font-size: var(--text-xs);
    font-weight: var(--weight-semibold);
    line-height: 1.6;
    white-space: nowrap;
  }

  /* 底色极淡，边框中间档，文字取满饱和 —— 保证在亮暗底上都读得清 */
  .diff-badge--success {
    background: var(--success-quiet);
    border-color: color-mix(in oklab, var(--success) 32%, transparent);
    color: var(--success);
  }

  .diff-badge--warning {
    background: var(--warning-quiet);
    border-color: color-mix(in oklab, var(--warning) 32%, transparent);
    color: var(--warning);
  }

  .diff-badge--danger {
    background: var(--danger-quiet);
    border-color: color-mix(in oklab, var(--danger) 32%, transparent);
    color: var(--danger);
  }
</style>
