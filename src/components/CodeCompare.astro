---
/**
 * 双语对照组件：Python 与 TypeScript 并排呈现（窄屏退化为上下排列）。
 *
 * 这是本站的核心差异化表达：让"对照"成为可扫视的版式。
 * 两栏用色相而非明度区分（Python 暖黄 / TypeScript 冷蓝），
 * 面板顶部各有一条语言色条，缩略扫视时也能分清左右。
 */
import { Code } from "@astrojs/starlight/components";

interface Props {
  py: string;
  ts: string;
  caption?: string;
  pyTitle?: string;
  tsTitle?: string;
}

const { py, ts, caption, pyTitle = "Python", tsTitle = "TypeScript" } = Astro.props;
---

<figure class="code-compare">
  {caption && <figcaption class="code-compare__caption" set:html={caption} />}
  <div class="code-compare__grid">
    <div class="code-compare__pane code-compare__pane--py">
      <div class="code-compare__header">
        <span class="lang-dot lang-dot--py" aria-hidden="true"></span>
        <span>{pyTitle}</span>
      </div>
      <Code code={py} lang="python" />
    </div>
    <div class="code-compare__pane code-compare__pane--ts">
      <div class="code-compare__header">
        <span class="lang-dot lang-dot--ts" aria-hidden="true"></span>
        <span>{tsTitle}</span>
      </div>
      <Code code={ts} lang="typescript" />
    </div>
  </div>
</figure>
